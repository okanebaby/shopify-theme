{% comment %}
  OKANE BABY Dark Luxury Streetwear Footer
  Features:
  - Charcoal Trust Boxes (Fast Global Shipping & 100% Secure Payments)
  - OKANE BABY Official Logo Asset + Newsletter (label, heading, input, boxy SUBSCRIBE button)
  - 3-Column Navigation (SHOP, INFORMATION, POLICIES) with existing active store links
  - Deep black aesthetic, clean typography (Roboto Condensed), 100% boxy buttons
  - Responsive desktop & mobile layouts
{% endcomment %}

<style>
  .okane-footer {
    background-color: #000000 !important;
    color: #ffffff !important;
    padding: 4rem 1.5rem 2.5rem 1.5rem !important;
    border-top: 1px solid rgba(255, 255, 255, 0.12) !important;
    font-family: 'Roboto Condensed', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  .okane-footer-container {
    max-width: 1320px !important;
    margin: 0 auto !important;
  }

  /* ----------------------------------------------------
     1. TOP TRUST BOXES (Charcoal Rectangular Boxes)
     ---------------------------------------------------- */
  .okane-trust-boxes {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 1.25rem !important;
    margin-bottom: 3.5rem !important;
  }

  .okane-trust-box {
    background-color: #141414 !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: 0px !important;
    padding: 1.4rem 2rem !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 16px !important;
    transition: background-color 0.25s ease, border-color 0.25s ease !important;
  }

  .okane-trust-box:hover {
    background-color: #1a1a1a !important;
    border-color: rgba(255, 255, 255, 0.2) !important;
  }

  .okane-trust-icon {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #ffffff !important;
    flex-shrink: 0 !important;
  }

  .okane-trust-icon svg {
    width: 26px !important;
    height: 26px !important;
    stroke: #ffffff !important;
  }

  .okane-trust-title {
    font-family: 'Roboto Condensed', 'Arial Black', sans-serif !important;
    font-size: 1.12rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
    color: #ffffff !important;
    margin: 0 !important;
  }

  /* ----------------------------------------------------
     2. MAIN FOOTER BODY (Logo + Newsletter on Left, Nav on Right)
     ---------------------------------------------------- */
  .okane-footer-main {
    display: grid !important;
    grid-template-columns: 1.15fr 1fr !important;
    gap: 4rem !important;
    align-items: start !important;
    padding-bottom: 3.5rem !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
  }

  /* Left Side: Brand Logo & Newsletter */
  .okane-footer-brand-section {
    display: flex !important;
    flex-direction: column !important;
    gap: 1rem !important;
    max-width: 520px !important;
  }

  .okane-footer-logo-wrapper {
    display: inline-block !important;
    margin-bottom: 0.25rem !important;
  }

  .okane-footer-logo-img {
    height: 56px !important;
    width: 56px !important;
    max-height: 64px !important;
    max-width: 64px !important;
    object-fit: contain !important;
    display: block !important;
  }

  .okane-footer-logo-text {
    font-family: 'Roboto Condensed', 'Arial Black', sans-serif !important;
    font-size: 1.7rem !important;
    font-weight: 900 !important;
    letter-spacing: 0.1em !important;
    color: #ffffff !important;
    text-transform: uppercase !important;
  }

  .okane-newsletter-label {
    font-family: 'Roboto Condensed', sans-serif !important;
    font-size: 0.78rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    color: rgba(255, 255, 255, 0.55) !important;
    margin: 0 !important;
  }

  .okane-newsletter-heading {
    font-family: 'Roboto Condensed', sans-serif !important;
    font-size: 1.18rem !important;
    font-weight: 700 !important;
    line-height: 1.4 !important;
    color: #ffffff !important;
    margin: 0 !important;
  }

  .okane-newsletter-form {
    margin-top: 0.5rem !important;
    width: 100% !important;
  }

  .okane-newsletter-input-group {
    display: flex !important;
    align-items: stretch !important;
    width: 100% !important;
    border-radius: 0px !important;
  }

  .okane-newsletter-input {
    flex: 1 !important;
    background-color: #121212 !important;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    border-right: none !important;
    border-radius: 0px !important;
    padding: 0.85rem 1.1rem !important;
    font-family: 'Roboto Condensed', sans-serif !important;
    font-size: 0.95rem !important;
    font-weight: 500 !important;
    box-sizing: border-box !important;
    outline: none !important;
    transition: border-color 0.2s ease !important;
  }

  .okane-newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.45) !important;
    text-transform: uppercase !important;
    font-size: 0.85rem !important;
    letter-spacing: 0.05em !important;
  }

  .okane-newsletter-input:focus {
    border-color: #ffffff !important;
  }

  .okane-newsletter-btn {
    background-color: #ffffff !important;
    color: #000000 !important;
    border: 1px solid #ffffff !important;
    border-radius: 0px !important;
    padding: 0.85rem 1.6rem !important;
    font-family: 'Roboto Condensed', 'Arial Black', sans-serif !important;
    font-size: 0.95rem !important;
    font-weight: 900 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    cursor: pointer !important;
    white-space: nowrap !important;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease !important;
    box-shadow: none !important;
    text-shadow: none !important;
  }

  .okane-newsletter-btn:hover {
    background-color: #000000 !important;
    color: #ffffff !important;
    border-color: #ffffff !important;
  }

  .okane-newsletter-message {
    font-size: 0.85rem !important;
    margin-top: 0.5rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.03em !important;
  }

  .okane-newsletter-message.success {
    color: #00d659 !important;
  }

  .okane-newsletter-message.error {
    color: #ff3344 !important;
  }

  /* Right Side: 3 Navigation Columns */
  .okane-footer-nav-grid {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 2rem !important;
  }

  .okane-footer-col {
    display: flex !important;
    flex-direction: column !important;
    gap: 1.1rem !important;
  }

  .okane-footer-col-title {
    font-family: 'Roboto Condensed', 'Arial Black', sans-serif !important;
    font-size: 0.92rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    color: #ffffff !important;
    margin: 0 !important;
    padding-bottom: 0.35rem !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15) !important;
  }

  .okane-footer-links {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0.75rem !important;
  }

  .okane-footer-links li a {
    color: rgba(255, 255, 255, 0.65) !important;
    text-decoration: none !important;
    font-size: 0.92rem !important;
    font-weight: 500 !important;
    letter-spacing: 0.02em !important;
    transition: color 0.2s ease, transform 0.2s ease !important;
    display: inline-block !important;
  }

  .okane-footer-links li a:hover {
    color: #ffffff !important;
    transform: translateX(3px) !important;
  }

  /* ----------------------------------------------------
     3. BOTTOM COPYRIGHT BAR
     ---------------------------------------------------- */
  .okane-footer-bottom {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding-top: 2rem !important;
    flex-wrap: wrap !important;
    gap: 1rem !important;
  }

  .okane-footer-copyright {
    font-size: 0.8rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.06em !important;
    color: rgba(255, 255, 255, 0.45) !important;
    text-transform: uppercase !important;
    margin: 0 !important;
  }

  .okane-footer-social-icons {
    display: flex !important;
    align-items: center !important;
    gap: 16px !important;
  }

  .okane-footer-social-icons a {
    color: rgba(255, 255, 255, 0.65) !important;
    transition: color 0.2s ease, transform 0.2s ease !important;
    display: flex !important;
    align-items: center !important;
  }

  .okane-footer-social-icons a:hover {
    color: #ffffff !important;
    transform: translateY(-2px) !important;
  }

  .okane-footer-social-icons svg {
    width: 18px !important;
    height: 18px !important;
    fill: currentColor !important;
  }

  /* ----------------------------------------------------
     4. RESPONSIVE DESIGN (Tablets & Mobile)
     ---------------------------------------------------- */
  @media screen and (max-width: 989px) {
    .okane-footer-main {
      grid-template-columns: 1fr !important;
      gap: 3rem !important;
    }
    .okane-footer-brand-section {
      max-width: 100% !important;
    }
  }

  @media screen and (max-width: 749px) {
    .okane-footer {
      padding: 2.5rem 1rem 2rem 1rem !important;
    }
    .okane-trust-boxes {
      display: flex !important;
      position: relative !important;
      width: 100% !important;
      height: 56px !important;
      min-height: 56px !important;
      background-color: #141414 !important;
      border: 1px solid rgba(255, 255, 255, 0.1) !important;
      border-radius: 0px !important;
      overflow: hidden !important;
      margin-bottom: 2.5rem !important;
      padding: 0 !important;
    }
    .okane-trust-box {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100% !important;
      padding: 0.85rem 1.25rem !important;
      justify-content: center !important;
      border: none !important;
      background: transparent !important;
      opacity: 0 !important;
      visibility: hidden !important;
      transform: translateX(35px) !important;
      transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.45s !important;
      pointer-events: none !important;
      box-sizing: border-box !important;
    }
    .okane-trust-box.is-active {
      opacity: 1 !important;
      visibility: visible !important;
      transform: translateX(0px) !important;
      pointer-events: auto !important;
    }
    .okane-trust-title {
      font-size: 0.94rem !important;
    }
    .okane-trust-icon svg {
      width: 22px !important;
      height: 22px !important;
    }
    .okane-footer-nav-grid {
      grid-template-columns: 1fr !important;
      gap: 2rem !important;
    }
    .okane-newsletter-input-group {
      flex-direction: column !important;
      gap: 8px !important;
    }
    .okane-newsletter-input {
      border-right: 1px solid rgba(255, 255, 255, 0.2) !important;
      width: 100% !important;
    }
    .okane-newsletter-btn {
      width: 100% !important;
      padding: 0.95rem 1rem !important;
    }
    .okane-footer-bottom {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 1rem !important;
    }
  }
</style>

<footer class="okane-footer" role="contentinfo">
  <div class="okane-footer-container">
    
    <!-- TOP TRUST BOXES -->
    <div class="okane-trust-boxes" id="OkaneTrustBoxes">
      <!-- BOX 1: Fast Global Shipping -->
      <div class="okane-trust-box is-active" data-trust-index="0">
        <div class="okane-trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 18H3c-.6 0-1-.4-1-1V7c0-.6.4-1 1-1h10c.6 0 1 .4 1 1v11"/>
            <path d="M14 9h4l4 4v4c0 .6-.4 1-1 1h-2"/>
            <circle cx="7" cy="18" r="2"/>
            <circle cx="17" cy="18" r="2"/>
          </svg>
        </div>
        <span class="okane-trust-title">Fast Global Shipping</span>
      </div>

      <!-- BOX 2: 100% Secure Payments -->
      <div class="okane-trust-box" data-trust-index="1">
        <div class="okane-trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="0" ry="0"/>
            <path d="M7 11V7a5 5 0 0110 0v4"/>
            <circle cx="12" cy="16" r="1.5"/>
          </svg>
        </div>
        <span class="okane-trust-title">100% Secure Payments</span>
      </div>
    </div>

    <!-- MAIN FOOTER BODY -->
    <div class="okane-footer-main">
      
      <!-- Left Column: OKANE BABY Logo + Newsletter -->
      <div class="okane-footer-brand-section">
        <div class="okane-footer-logo-wrapper">
          {%- if section.settings.logo != blank -%}
            <img 
              src="{{ section.settings.logo | image_url: width: 340 }}" 
              alt="{{ shop.name | escape }}" 
              class="okane-footer-logo-img" 
              loading="lazy" 
              width="56" 
              height="56"
            >
          {%- else -%}
            <img 
              src="{{ 'okane-emblem-white.png' | asset_url }}" 
              alt="OKANE BABY" 
              class="okane-footer-logo-img" 
              loading="lazy" 
              width="56" 
              height="56"
            >
          {%- endif -%}
        </div>

        <p class="okane-newsletter-label">OKANE BABY NEWSLETTER</p>
        
        <p class="okane-newsletter-heading">
          Sign up to receive early access, exclusive discounts and upcoming drops.
        </p>

        <!-- Newsletter Signup Form -->
        {%- form 'customer', id: 'OkaneFooterNewsletter', class: 'okane-newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="okane-newsletter-input-group">
            <input
              id="OkaneNewsletterInput"
              type="email"
              name="contact[email]"
              class="okane-newsletter-input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="Email address"
              required
            >
            <button type="submit" class="okane-newsletter-btn" name="commit" id="OkaneNewsletterSubmit">
              SUBSCRIBE
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="okane-newsletter-message success" tabindex="-1" autofocus>
              Thank you for subscribing to OKANE BABY.
            </p>
          {%- elsif form.errors -%}
            <p class="okane-newsletter-message error" tabindex="-1" autofocus>
              {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>

      <!-- Right Column: 3-Column Navigation Grid -->
      <div class="okane-footer-nav-grid">
        
        <!-- Column 1: SHOP -->
        <div class="okane-footer-col">
          <h3 class="okane-footer-col-title">SHOP</h3>
          <ul class="okane-footer-links">
            <li><a href="/products/broken-halo-set-ash-black">Broken Halo Collection</a></li>
            <li><a href="/collections/all">Shop All</a></li>
            <li><a href="/collections/all">New Releases</a></li>
          </ul>
        </div>

        <!-- Column 2: INFORMATION -->
        <div class="okane-footer-col">
          <h3 class="okane-footer-col-title">INFORMATION</h3>
          <ul class="okane-footer-links">
            <li><a href="{{ pages['about-us'].url | default: pages['about'].url | default: '/pages/about-us' }}">About Us</a></li>
            <li><a href="{{ pages['contact'].url | default: '/pages/contact' }}">Contact</a></li>
            <li><a href="{{ pages['track-your-order'].url | default: pages['tracking'].url | default: pages['order-lookup'].url | default: '/pages/track-your-order' }}">Track Your Order</a></li>
            <li><a href="#size-guide" onclick="const btn = document.getElementById('open-fit-quiz-btn'); if (btn) { btn.click(); return false; }">Size Guide</a></li>
          </ul>
        </div>

        <!-- Column 3: POLICIES -->
        <div class="okane-footer-col">
          <h3 class="okane-footer-col-title">POLICIES</h3>
          <ul class="okane-footer-links">
            <li><a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">Shipping Policy</a></li>
            <li><a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">Refund Policy</a></li>
            <li><a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy Policy</a></li>
            <li><a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}">Terms of Service</a></li>
          </ul>
        </div>

      </div>

    </div>

    <!-- BOTTOM COPYRIGHT BAR -->
    <div class="okane-footer-bottom">
      <p class="okane-footer-copyright">
        &copy; {{ 'now' | date: "%Y" }} OKANE BABY. ALL RIGHTS RESERVED.
      </p>

      <div class="okane-footer-social-icons">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            {%- render 'icon-instagram' -%}
          </a>
        {%- else -%}
          <a href="https://www.instagram.com/okanebaby/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            {%- render 'icon-instagram' -%}
          </a>
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}
          <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
            {%- render 'icon-tiktok' -%}
          </a>
        {%- endif -%}
      </div>
    </div>

  </div>
</footer>

<script>
  (function() {
    function initMobileTrustCarousel() {
      const container = document.getElementById('OkaneTrustBoxes');
      if (!container) return;

      const boxes = Array.from(container.querySelectorAll('.okane-trust-box'));
      if (boxes.length <= 1) return;

      let currentIdx = 0;

      function rotateTrust() {
        if (window.innerWidth < 750) {
          boxes[currentIdx].classList.remove('is-active');
          currentIdx = (currentIdx + 1) % boxes.length;
          boxes[currentIdx].classList.add('is-active');
        } else {
          boxes.forEach(b => b.classList.add('is-active'));
        }
      }

      setInterval(rotateTrust, 3200);

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 750) {
          boxes.forEach(b => b.classList.add('is-active'));
        } else {
          boxes.forEach((b, i) => {
            if (i === currentIdx) b.classList.add('is-active');
            else b.classList.remove('is-active');
          });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMobileTrustCarousel);
    } else {
      initMobileTrustCarousel();
    }
  })();
</script>

