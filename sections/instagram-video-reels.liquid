{% comment %}
  Instagram Video Reels Carousel Section
  Matches Worstwork.com 1:1:
  - 9:16 Vertical Video Reels in a smooth horizontal scroll gallery
  - Individual Audio Mute / Unmute Button (🔊 / 🔇)
  - Individual Play / Pause Toggle (▶ / ⏸)
  - Left & Right Circular Slider Navigation Arrows (‹ and ›)
  - Direct Links to https://www.instagram.com/okanebaby/
  - Touch-friendly swipe on mobile
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}

<style>
  .instagram-reels-section {
    position: relative;
    width: 100%;
    padding: {{ section.settings.padding_top | default: 40 }}px 0 {{ section.settings.padding_bottom | default: 50 }}px 0;
    background-color: {{ section.settings.background_color | default: '#ffffff' }};
    overflow: hidden;
  }

  .instagram-reels-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 48px 20px 48px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .instagram-reels-title {
    font-family: 'Roboto Condensed', 'Arial Black', -apple-system, BlinkMacSystemFont, sans-serif !important;
    font-size: clamp(1.25rem, 2.2vw, 1.85rem) !important;
    font-weight: 800 !important;
    letter-spacing: 0.04em !important;
    text-transform: uppercase !important;
    color: #000000 !important;
    margin: 0 !important;
  }

  .instagram-reels-profile-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Roboto Condensed', sans-serif !important;
    font-size: 0.95rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
    color: #000000 !important;
    text-decoration: none !important;
    transition: opacity 0.2s ease;
  }

  .instagram-reels-profile-link:hover {
    opacity: 0.7;
  }

  .instagram-reels-slider-wrapper {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 48px;
    box-sizing: border-box;
  }

  .instagram-reels-slider {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 0 20px 0;
  }

  .instagram-reels-slider::-webkit-scrollbar {
    display: none;
  }

  /* Individual Reel Card - 9:16 Aspect Ratio */
  .instagram-reel-card {
    flex: 0 0 270px;
    aspect-ratio: 9 / 16;
    height: 480px;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    scroll-snap-align: start;
    background-color: #000000;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.09);
    cursor: pointer;
    user-select: none;
  }

  @media screen and (max-width: 749px) {
    .instagram-reels-header {
      padding: 0 20px 14px 20px;
    }
    .instagram-reels-slider-wrapper {
      padding: 0 16px;
    }
    .instagram-reel-card {
      flex: 0 0 220px;
      height: 390px;
      border-radius: 6px;
    }
  }

  .instagram-reel-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: auto;
  }

  /* Top-Right Floating Controls (Mute/Unmute and Play/Pause) */
  .reel-controls-bar {
    position: absolute;
    top: 14px;
    right: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 5;
    pointer-events: auto;
  }

  .reel-control-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    padding: 0;
  }

  .reel-control-btn:hover {
    background: rgba(0, 0, 0, 0.85);
    transform: scale(1.08);
  }

  .reel-control-btn svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  /* Bottom Instagram Badge Overlay */
  .reel-bottom-badge {
    position: absolute;
    bottom: 14px;
    left: 14px;
    right: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 5;
    pointer-events: auto;
  }

  .reel-ig-handle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    padding: 4px 12px;
    color: #ffffff;
    font-family: 'Roboto Condensed', sans-serif;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .reel-ig-handle:hover {
    background: rgba(0, 0, 0, 0.85);
    transform: scale(1.03);
  }

  .reel-ig-handle svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  /* Slider Circular Navigation Arrows (Matching Worstwork.com) */
  .reels-nav-arrow {
    position: absolute;
    top: calc(50% - 10px);
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    padding: 0;
  }

  .reels-nav-arrow:hover {
    transform: translateY(-50%) scale(1.1);
    background-color: #f7f7f7;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  }

  .reels-nav-arrow.prev {
    left: 20px;
  }

  .reels-nav-arrow.next {
    right: 20px;
  }

  .reels-nav-arrow svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media screen and (max-width: 749px) {
    .reels-nav-arrow {
      display: none;
    }
  }
</style>

<div class="instagram-reels-section">
  
  <div class="instagram-reels-header">
    <h2 class="instagram-reels-title">
      {{ section.settings.heading | default: 'ME AGAINST MYSELF' }}
    </h2>
    <a href="https://www.instagram.com/okanebaby/" target="_blank" rel="noopener noreferrer" class="instagram-reels-profile-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
      @okanebaby
    </a>
  </div>

  <div class="instagram-reels-slider-wrapper">
    
    <!-- Prev Arrow Button -->
    <button type="button" class="reels-nav-arrow prev" id="ReelsPrevBtn" aria-label="Previous Videos">
      <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>

    <!-- Carousel Slider -->
    <div class="instagram-reels-slider" id="InstagramReelsSlider">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign video_src = block.settings.video_url
            if video_src == blank and block.settings.video_asset != blank
              assign video_src = block.settings.video_asset | asset_url
            endif
          -%}
          {%- if video_src != blank -%}
            <div class="instagram-reel-card" {{ block.shopify_attributes }}>
              
              <!-- Floating Top Controls -->
              <div class="reel-controls-bar">
                <button type="button" class="reel-control-btn reel-audio-toggle" aria-label="Toggle Sound">
                  <!-- Muted Icon (Default) -->
                  <svg class="icon-muted" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
                  </svg>
                  <!-- Unmuted Icon -->
                  <svg class="icon-unmuted" style="display: none;" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                  </svg>
                </button>

                <button type="button" class="reel-control-btn reel-playback-toggle" aria-label="Play or Pause">
                  <!-- Pause Icon (Default when playing) -->
                  <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                  </svg>
                  <!-- Play Icon -->
                  <svg class="icon-play" style="display: none;" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
              </div>

              <!-- HTML5 Autoplaying Video -->
              <video
                class="instagram-reel-video"
                src="{{ video_src }}"
                autoplay
                loop
                muted
                playsinline
                webkit-playsinline
                preload="metadata"
              ></video>

              <!-- Bottom Instagram Tag Link -->
              <div class="reel-bottom-badge">
                <a href="{{ block.settings.instagram_link | default: 'https://www.instagram.com/okanebaby/' }}" target="_blank" rel="noopener noreferrer" class="reel-ig-handle">
                  <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                  <span>@okanebaby</span>
                </a>
              </div>

            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <!-- Next Arrow Button -->
    <button type="button" class="reels-nav-arrow next" id="ReelsNextBtn" aria-label="Next Videos">
      <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>

  </div>

</div>

<script>
  (function() {
    function initInstagramReels() {
      const slider = document.getElementById('InstagramReelsSlider');
      const prevBtn = document.getElementById('ReelsPrevBtn');
      const nextBtn = document.getElementById('ReelsNextBtn');

      if (!slider) return;

      // Scroll arrows
      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          slider.scrollBy({ left: -320, behavior: 'smooth' });
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          slider.scrollBy({ left: 320, behavior: 'smooth' });
        });
      }

      // Initialize all cards
      const cards = slider.querySelectorAll('.instagram-reel-card');
      cards.forEach(card => {
        const video = card.querySelector('video');
        const audioBtn = card.querySelector('.reel-audio-toggle');
        const playbackBtn = card.querySelector('.reel-playback-toggle');

        if (!video) return;

        // Audio toggle
        if (audioBtn) {
          audioBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const iconMuted = audioBtn.querySelector('.icon-muted');
            const iconUnmuted = audioBtn.querySelector('.icon-unmuted');

            if (video.muted) {
              // Mute all other videos first
              document.querySelectorAll('.instagram-reel-video').forEach(v => {
                v.muted = true;
              });
              document.querySelectorAll('.reel-audio-toggle').forEach(btn => {
                btn.querySelector('.icon-muted').style.display = 'block';
                btn.querySelector('.icon-unmuted').style.display = 'none';
              });

              video.muted = false;
              video.volume = 1.0;
              iconMuted.style.display = 'none';
              iconUnmuted.style.display = 'block';
            } else {
              video.muted = true;
              iconMuted.style.display = 'block';
              iconUnmuted.style.display = 'none';
            }
          });
        }

        // Playback toggle
        if (playbackBtn) {
          playbackBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const iconPause = playbackBtn.querySelector('.icon-pause');
            const iconPlay = playbackBtn.querySelector('.icon-play');

            if (video.paused) {
              video.play();
              iconPause.style.display = 'block';
              iconPlay.style.display = 'none';
            } else {
              video.pause();
              iconPause.style.display = 'none';
              iconPlay.style.display = 'block';
            }
          });
        }

        // Click on video to toggle play/pause
        video.addEventListener('click', () => {
          if (playbackBtn) playbackBtn.click();
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initInstagramReels);
    } else {
      initInstagramReels();
    }
  })();
</script>

{% schema %}
{
  "name": "Instagram Video Reels",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "ME AGAINST MYSELF"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Video Reel",
      "settings": [
        {
          "type": "text",
          "id": "video_asset",
          "label": "Video Asset Filename (e.g. reel-1.mp4)",
          "info": "Filename of MP4 in assets folder"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Or External / Shopify File Video URL",
          "info": "Direct MP4 link"
        },
        {
          "type": "text",
          "id": "instagram_link",
          "label": "Instagram Post Link",
          "default": "https://www.instagram.com/okanebaby/"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Video Reels",
      "blocks": [
        {
          "type": "reel",
          "settings": {
            "video_asset": "reel-1.mp4"
          }
        },
        {
          "type": "reel",
          "settings": {
            "video_asset": "reel-2.mp4"
          }
        },
        {
          "type": "reel",
          "settings": {
            "video_asset": "reel-3.mp4"
          }
        },
        {
          "type": "reel",
          "settings": {
            "video_asset": "reel-4.mp4"
          }
        },
        {
          "type": "reel",
          "settings": {
            "video_asset": "reel-5.mp4"
          }
        }
      ]
    }
  ]
}
{% endschema %}
