{% comment %}
  3D Perspective Coverflow Instagram Video Reels Carousel
  Matches Worstwork.com 1:1:
  - 3D Tilted Coverflow Perspective Carousel
  - Only the center active video plays automatically and is prominently enlarged
  - Side videos tilt inward with 3D rotation, reduced scale, and soft dimming
  - Clicking any side video rotates it directly to the center and plays it
  - Left & Right Navigation Arrows (‹ and ›)
  - Audio Mute / Unmute (🔊 / 🔇) & Play / Pause (▶ / ⏸) controls on active video
  - Touch-friendly swipe on mobile and mouse drag on desktop
  - Direct Instagram integration (@okanebaby)
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}

<style>
  .instagram-reels-section-{{ section.id }} {
    position: relative;
    width: 100%;
    padding: {{ section.settings.padding_top | default: 40 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px 0;
    background-color: {{ section.settings.background_color | default: '#ffffff' }};
    overflow: hidden;
  }

  .instagram-reels-header-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 48px 24px 48px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .instagram-reels-title-{{ section.id }} {
    font-family: 'Roboto Condensed', 'Arial Black', -apple-system, BlinkMacSystemFont, sans-serif !important;
    font-size: clamp(1.25rem, 2.2vw, 1.85rem) !important;
    font-weight: 800 !important;
    letter-spacing: 0.04em !important;
    text-transform: uppercase !important;
    color: #000000 !important;
    margin: 0 !important;
  }

  .instagram-reels-profile-link-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Roboto Condensed', sans-serif !important;
    font-size: 0.95rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
    color: #000000 !important;
    text-decoration: none !important;
    transition: opacity 0.2s ease;
  }

  .instagram-reels-profile-link-{{ section.id }}:hover {
    opacity: 0.7;
  }

  /* 3D Perspective Stage Container */
  .instagram-reels-stage-wrapper-{{ section.id }} {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .instagram-reels-stage-{{ section.id }} {
    position: relative;
    width: 100%;
    height: 560px;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1300px;
    perspective-origin: 50% 50%;
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
  }

  @media screen and (max-width: 749px) {
    .instagram-reels-header-{{ section.id }} {
      padding: 0 20px 16px 20px;
    }
    .instagram-reels-stage-{{ section.id }} {
      height: 430px;
      perspective: 900px;
    }
  }

  /* 3D Individual Card */
  .instagram-reel-card-{{ section.id }} {
    position: absolute;
    width: 280px;
    height: 490px;
    aspect-ratio: 9 / 16;
    border-radius: 10px;
    overflow: hidden;
    background-color: #000000;
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s ease, filter 0.5s ease, box-shadow 0.5s ease;
    cursor: pointer;
    will-change: transform, opacity;
  }

  @media screen and (max-width: 749px) {
    .instagram-reel-card-{{ section.id }} {
      width: 215px;
      height: 380px;
      border-radius: 8px;
    }
  }

  .instagram-reel-video-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: auto;
  }

  /* Non-active Card Overlay: Darker tint to make the center video pop */
  .reel-dimmer-overlay-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.3);
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 2;
  }

  .instagram-reel-card-{{ section.id }}.is-active .reel-dimmer-overlay-{{ section.id }} {
    opacity: 0;
  }

  /* Top-Right Floating Controls on Active Video */
  .reel-controls-bar-{{ section.id }} {
    position: absolute;
    top: 14px;
    right: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 5;
    pointer-events: auto;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .instagram-reel-card-{{ section.id }}.is-active .reel-controls-bar-{{ section.id }} {
    opacity: 1;
  }

  .reel-control-btn-{{ section.id }} {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    padding: 0;
  }

  .reel-control-btn-{{ section.id }}:hover {
    background: rgba(0, 0, 0, 0.9);
    transform: scale(1.08);
  }

  .reel-control-btn-{{ section.id }} svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  /* Bottom Instagram Badge Overlay */
  .reel-bottom-badge-{{ section.id }} {
    position: absolute;
    bottom: 14px;
    left: 14px;
    right: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 5;
    pointer-events: auto;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .instagram-reel-card-{{ section.id }}.is-active .reel-bottom-badge-{{ section.id }} {
    opacity: 1;
  }

  .reel-ig-handle-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 20px;
    padding: 5px 13px;
    color: #ffffff;
    font-family: 'Roboto Condensed', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .reel-ig-handle-{{ section.id }}:hover {
    background: rgba(0, 0, 0, 0.9);
    transform: scale(1.03);
  }

  .reel-ig-handle-{{ section.id }} svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  /* Circular Navigation Arrows */
  .reels-nav-arrow-{{ section.id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.22);
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 25;
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    padding: 0;
  }

  .reels-nav-arrow-{{ section.id }}:hover {
    transform: translateY(-50%) scale(1.12);
    background-color: #f8f8f8;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);
  }

  .reels-nav-arrow-{{ section.id }}.prev {
    left: 24px;
  }

  .reels-nav-arrow-{{ section.id }}.next {
    right: 24px;
  }

  .reels-nav-arrow-{{ section.id }} svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media screen and (max-width: 749px) {
    .reels-nav-arrow-{{ section.id }} {
      width: 38px;
      height: 38px;
    }
    .reels-nav-arrow-{{ section.id }}.prev {
      left: 10px;
    }
    .reels-nav-arrow-{{ section.id }}.next {
      right: 10px;
    }
  }
</style>

<div class="instagram-reels-section-{{ section.id }}">
  
  <div class="instagram-reels-header-{{ section.id }}">
    <h2 class="instagram-reels-title-{{ section.id }}">
      {{ section.settings.heading | default: 'ME AGAINST MYSELF' }}
    </h2>
    <a href="https://www.instagram.com/okanebaby/" target="_blank" rel="noopener noreferrer" class="instagram-reels-profile-link-{{ section.id }}">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
      @okanebaby
    </a>
  </div>

  <div class="instagram-reels-stage-wrapper-{{ section.id }}">
    
    <!-- Prev Navigation Arrow -->
    <button type="button" class="reels-nav-arrow-{{ section.id }} prev" id="ReelsPrevBtn-{{ section.id }}" aria-label="Previous Video">
      <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>

    <!-- 3D Coverflow Stage -->
    <div class="instagram-reels-stage-{{ section.id }}" id="InstagramReelsStage-{{ section.id }}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign video_src = block.settings.video_url
            if video_src == blank and block.settings.video_asset != blank
              assign video_src = block.settings.video_asset | asset_url
            endif
          -%}
          {%- if video_src != blank -%}
            <div class="instagram-reel-card-{{ section.id }}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              
              <!-- Darkening overlay for non-active side cards -->
              <div class="reel-dimmer-overlay-{{ section.id }}"></div>

              <!-- Top-Right Controls on Active Video -->
              <div class="reel-controls-bar-{{ section.id }}">
                <button type="button" class="reel-control-btn-{{ section.id }} reel-audio-toggle" aria-label="Toggle Sound">
                  <!-- Muted Icon -->
                  <svg class="icon-muted" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
                  </svg>
                  <!-- Unmuted Icon -->
                  <svg class="icon-unmuted" style="display: none;" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                  </svg>
                </button>

                <button type="button" class="reel-control-btn-{{ section.id }} reel-playback-toggle" aria-label="Play or Pause">
                  <!-- Pause Icon (Default when playing) -->
                  <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                  </svg>
                  <!-- Play Icon -->
                  <svg class="icon-play" style="display: none;" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
              </div>

              <!-- HTML5 Video -->
              <video
                class="instagram-reel-video-{{ section.id }}"
                src="{{ video_src }}"
                loop
                muted
                playsinline
                webkit-playsinline
                preload="metadata"
              ></video>

              <!-- Bottom Instagram Tag Link -->
              <div class="reel-bottom-badge-{{ section.id }}">
                <a href="{{ block.settings.instagram_link | default: 'https://www.instagram.com/okanebaby/' }}" target="_blank" rel="noopener noreferrer" class="reel-ig-handle-{{ section.id }}">
                  <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                  <span>@okanebaby</span>
                </a>
              </div>

            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <!-- Next Navigation Arrow -->
    <button type="button" class="reels-nav-arrow-{{ section.id }} next" id="ReelsNextBtn-{{ section.id }}" aria-label="Next Video">
      <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>

  </div>

</div>

<script>
  (function() {
    function init3DInstagramReels_{{ section.id | replace: '-', '_' }}() {
      const stage = document.getElementById('InstagramReelsStage-{{ section.id }}');
      const prevBtn = document.getElementById('ReelsPrevBtn-{{ section.id }}');
      const nextBtn = document.getElementById('ReelsNextBtn-{{ section.id }}');

      if (!stage) return;

      const cards = Array.from(stage.querySelectorAll('.instagram-reel-card-{{ section.id }}'));
      const total = cards.length;
      if (total === 0) return;

      let currentIndex = 0;
      let isSoundUnmuted = false;

      function updateCoverflow() {
        const isMobile = window.innerWidth < 750;
        const spacing = isMobile ? 150 : 255;
        const outerSpacing = isMobile ? 275 : 460;

        cards.forEach((card, index) => {
          let offset = index - currentIndex;

          if (offset > total / 2) offset -= total;
          if (offset < -total / 2) offset += total;

          const video = card.querySelector('video');
          const playbackBtn = card.querySelector('.reel-playback-toggle');
          const audioBtn = card.querySelector('.reel-audio-toggle');

          if (offset === 0) {
            card.classList.add('is-active');
            card.style.transform = `translateX(0px) translateZ(60px) scale(${isMobile ? 1.08 : 1.16}) rotateY(0deg)`;
            card.style.zIndex = '15';
            card.style.opacity = '1';
            card.style.filter = 'brightness(1)';
            card.style.boxShadow = '0 20px 45px rgba(0, 0, 0, 0.45)';
            card.style.pointerEvents = 'auto';

            if (video) {
              video.muted = !isSoundUnmuted;
              const playPromise = video.play();
              if (playPromise !== undefined) {
                playPromise.catch(() => {});
              }
              if (playbackBtn) {
                playbackBtn.querySelector('.icon-pause').style.display = 'block';
                playbackBtn.querySelector('.icon-play').style.display = 'none';
              }
            }
          } else if (offset === -1) {
            card.classList.remove('is-active');
            card.style.transform = `translateX(-${spacing}px) translateZ(0px) scale(${isMobile ? 0.84 : 0.91}) rotateY(${isMobile ? 18 : 24}deg)`;
            card.style.zIndex = '10';
            card.style.opacity = '0.85';
            card.style.filter = 'brightness(0.72)';
            card.style.boxShadow = '0 10px 25px rgba(0, 0, 0, 0.25)';
            card.style.pointerEvents = 'auto';
            if (video) video.pause();
          } else if (offset === 1) {
            card.classList.remove('is-active');
            card.style.transform = `translateX(${spacing}px) translateZ(0px) scale(${isMobile ? 0.84 : 0.91}) rotateY(-${isMobile ? 18 : 24}deg)`;
            card.style.zIndex = '10';
            card.style.opacity = '0.85';
            card.style.filter = 'brightness(0.72)';
            card.style.boxShadow = '0 10px 25px rgba(0, 0, 0, 0.25)';
            card.style.pointerEvents = 'auto';
            if (video) video.pause();
          } else if (offset === -2) {
            card.classList.remove('is-active');
            card.style.transform = `translateX(-${outerSpacing}px) translateZ(-60px) scale(${isMobile ? 0.68 : 0.76}) rotateY(${isMobile ? 26 : 35}deg)`;
            card.style.zIndex = '5';
            card.style.opacity = isMobile ? '0.25' : '0.6';
            card.style.filter = 'brightness(0.5)';
            card.style.boxShadow = '0 6px 18px rgba(0, 0, 0, 0.18)';
            card.style.pointerEvents = 'auto';
            if (video) video.pause();
          } else if (offset === 2) {
            card.classList.remove('is-active');
            card.style.transform = `translateX(${outerSpacing}px) translateZ(-60px) scale(${isMobile ? 0.68 : 0.76}) rotateY(-${isMobile ? 26 : 35}deg)`;
            card.style.zIndex = '5';
            card.style.opacity = isMobile ? '0.25' : '0.6';
            card.style.filter = 'brightness(0.5)';
            card.style.boxShadow = '0 6px 18px rgba(0, 0, 0, 0.18)';
            card.style.pointerEvents = 'auto';
            if (video) video.pause();
          } else {
            card.classList.remove('is-active');
            const direction = offset > 0 ? 1 : -1;
            card.style.transform = `translateX(${direction * (outerSpacing + 200)}px) translateZ(-120px) scale(0.6) rotateY(${-direction * 45}deg)`;
            card.style.zIndex = '1';
            card.style.opacity = '0';
            card.style.pointerEvents = 'none';
            if (video) video.pause();
          }
        });
      }

      function goToSlide(index) {
        currentIndex = (index + total) % total;
        updateCoverflow();
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.preventDefault();
          goToSlide(currentIndex - 1);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', (e) => {
          e.preventDefault();
          goToSlide(currentIndex + 1);
        });
      }

      cards.forEach((card, index) => {
        card.addEventListener('click', (e) => {
          if (e.target.closest('.reel-control-btn-{{ section.id }}') || e.target.closest('.reel-ig-handle-{{ section.id }}')) {
            return;
          }
          if (currentIndex !== index) {
            e.preventDefault();
            goToSlide(index);
          }
        });

        const audioBtn = card.querySelector('.reel-audio-toggle');
        const video = card.querySelector('video');
        if (audioBtn && video) {
          audioBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            isSoundUnmuted = !isSoundUnmuted;
            video.muted = !isSoundUnmuted;

            stage.querySelectorAll('.reel-audio-toggle').forEach(btn => {
              btn.querySelector('.icon-muted').style.display = isSoundUnmuted ? 'none' : 'block';
              btn.querySelector('.icon-unmuted').style.display = isSoundUnmuted ? 'block' : 'none';
            });
          });
        }

        const playbackBtn = card.querySelector('.reel-playback-toggle');
        if (playbackBtn && video) {
          playbackBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (video.paused) {
              video.play();
              playbackBtn.querySelector('.icon-pause').style.display = 'block';
              playbackBtn.querySelector('.icon-play').style.display = 'none';
            } else {
              video.pause();
              playbackBtn.querySelector('.icon-pause').style.display = 'none';
              playbackBtn.querySelector('.icon-play').style.display = 'block';
            }
          });
        }
      });

      let touchStartX = 0;
      let touchEndX = 0;

      stage.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      stage.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        handleGesture();
      }, { passive: true });

      function handleGesture() {
        const threshold = 40;
        if (touchEndX < touchStartX - threshold) {
          goToSlide(currentIndex + 1);
        } else if (touchEndX > touchStartX + threshold) {
          goToSlide(currentIndex - 1);
        }
      }

      window.addEventListener('resize', updateCoverflow);
      updateCoverflow();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init3DInstagramReels_{{ section.id | replace: '-', '_' }});
    } else {
      init3DInstagramReels_{{ section.id | replace: '-', '_' }}();
    }
  })();
</script>

