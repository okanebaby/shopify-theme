{% comment %}
  Announcement Bar with Live Visitor Indicator
  Features:
  - Far-left bright green status dot + visitor count ("● 127 live visitors")
  - Approximately 45-50px horizontal padding on desktop
  - Subtle gradual range fluctuation (100–150 range, gentle transitions)
  - Centered announcement message with responsive mobile layout
{% endcomment %}

<style>
  .announcement-bar {
    position: relative !important;
    width: 100% !important;
    background-color: #000000 !important;
    color: #ffffff !important;
    min-height: 38px !important;
    display: flex !important;
    align-items: center !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
  }

  .announcement-bar-wrapper {
    position: relative !important;
    width: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0.55rem 1rem !important;
    box-sizing: border-box !important;
  }

  /* Far-left live visitor indicator with ~48px desktop horizontal padding */
  .announcement-live-visitors {
    position: absolute !important;
    left: 48px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 7px !important;
    color: #ffffff !important;
    font-family: 'Roboto Condensed', 'Arial Black', -apple-system, BlinkMacSystemFont, sans-serif !important;
    font-size: 0.82rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.04em !important;
    text-transform: uppercase !important;
    user-select: none !important;
    z-index: 3 !important;
    white-space: nowrap !important;
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    box-shadow: none !important;
    text-shadow: none !important;
  }

  /* Small bright green status dot */
  .live-visitor-green-dot {
    width: 7.5px !important;
    height: 7.5px !important;
    background-color: #00ff66 !important;
    border-radius: 50% !important;
    display: inline-block !important;
    box-shadow: 0 0 7px rgba(0, 255, 102, 0.9) !important;
    flex-shrink: 0 !important;
    animation: live-green-dot-pulse 2.2s infinite ease-in-out !important;
  }

  @keyframes live-green-dot-pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
      box-shadow: 0 0 6px rgba(0, 255, 102, 0.9);
    }
    50% {
      opacity: 0.65;
      transform: scale(0.85);
      box-shadow: 0 0 2px rgba(0, 255, 102, 0.4);
    }
  }

  .live-visitor-text {
    color: #ffffff !important;
    line-height: 1 !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 4px !important;
  }

  .announcement-bar__link {
    text-decoration: none !important;
    color: inherit !important;
    display: inline-flex !important;
    align-items: center !important;
  }

  .announcement-bar__message {
    font-family: 'Roboto Condensed', 'Arial Black', sans-serif !important;
    font-size: 0.85rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    color: #ffffff !important;
    margin: 0 !important;
    padding: 0 !important;
    text-align: center !important;
    text-shadow: none !important;
  }

  @media screen and (max-width: 989px) {
    .announcement-live-visitors {
      left: 20px !important;
      font-size: 0.76rem !important;
    }
  }

  @media screen and (max-width: 749px) {
    .announcement-bar-wrapper {
      flex-direction: row !important;
      justify-content: space-between !important;
      padding: 0.45rem 12px !important;
      gap: 8px !important;
    }
    .announcement-live-visitors {
      position: static !important;
      transform: none !important;
      font-size: 0.72rem !important;
      gap: 5px !important;
    }
    .live-visitor-green-dot {
      width: 6.5px !important;
      height: 6.5px !important;
    }
    .announcement-bar__message {
      font-size: 0.74rem !important;
      letter-spacing: 0.05em !important;
    }
  }
</style>

<div class="announcement-bar color-{{ section.settings.color_scheme | default: 'accent-1' }}" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
  <div class="announcement-bar-wrapper">
    
    <!-- Far-Left Live Visitor Indicator -->
    <div class="announcement-live-visitors" id="AnnouncementLiveVisitors">
      <span class="live-visitor-green-dot" aria-hidden="true"></span>
      <span class="live-visitor-text">
        <span id="AnnouncementVisitorCount">127</span> live visitors
      </span>
    </div>

    <!-- Centered Announcement Message -->
    {%- assign announcement_text = "THEY CAN'T BE US" -%}
    {%- assign announcement_link = "" -%}
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'announcement' and block.settings.text != blank -%}
          {%- assign announcement_text = block.settings.text -%}
          {%- assign announcement_link = block.settings.link -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if announcement_link != blank -%}
      <a href="{{ announcement_link }}" class="announcement-bar__link">
        <p class="announcement-bar__message">
          {{ announcement_text | escape }}
          {% render 'icon-arrow' %}
        </p>
      </a>
    {%- else -%}
      <p class="announcement-bar__message">
        {{ announcement_text | escape }}
      </p>
    {%- endif -%}

  </div>
</div>

<script>
  (function() {
    function initLiveVisitorCounter() {
      const countEl = document.getElementById('AnnouncementVisitorCount');
      if (!countEl) return;

      let currentCount = 127;

      function updateCounter() {
        // Subtle gradual fluctuation: +/- 1 or 2 within 118 to 142
        const change = (Math.random() < 0.5 ? -1 : 1) * (Math.random() < 0.3 ? 2 : 1);
        currentCount = Math.max(118, Math.min(142, currentCount + change));
        countEl.textContent = currentCount;

        // Schedule next update between 14 to 26 seconds
        const nextDelay = Math.floor(Math.random() * 12000) + 14000;
        setTimeout(updateCounter, nextDelay);
      }

      // Initial schedule
      setTimeout(updateCounter, 16000);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLiveVisitorCounter);
    } else {
      initLiveVisitorCounter();
    }
  })();
</script>

{% schema %}
{
  "name": "Announcement Bar",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "accent-1",
      "label": "Color scheme"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "THEY CAN'T BE US",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement"
      }
    ]
  }
}
{% endschema %}
