{% comment %}
  OKANE BABY Infinite Seamless Marquee Announcement Bar
  Features:
  - Continuous right-to-left seamless infinite scrolling marquee loop (no pauses, no blank gaps)
  - Custom marquee text: FREE SHIPPING ACROSS AUSTRALIA ✦ USE CODE ‘LIMITED’ FOR 10% OFF ✦ BROKEN HALO COLLECTION ✦ LIMITED STOCK AVAILABLE ✦
  - Desktop Live Visitor Counter at top left
  - Clean bold sans-serif typography
{% endcomment %}

<style>
  .announcement-bar {
    position: relative !important;
    width: 100% !important;
    background-color: #000000 !important;
    color: #ffffff !important;
    height: 38px !important;
    min-height: 38px !important;
    display: flex !important;
    align-items: center !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12) !important;
    z-index: 50 !important;
    overflow: hidden !important;
  }

  /* Live Visitor Counter Badge (Desktop Top Left) */
  .announcement-live-visitors {
    position: absolute !important;
    left: 20px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 7px !important;
    color: rgba(255, 255, 255, 0.95) !important;
    font-family: 'Roboto Condensed', 'Arial Black', -apple-system, BlinkMacSystemFont, sans-serif !important;
    font-size: 0.76rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
    user-select: none !important;
    z-index: 10 !important;
    background: #000000 !important;
    padding: 3px 12px 3px 6px !important;
    box-shadow: 12px 0 16px 4px #000000 !important;
    white-space: nowrap !important;
  }

  .live-visitor-green-dot {
    width: 7px !important;
    height: 7px !important;
    background-color: #00d659 !important;
    border-radius: 50% !important;
    display: inline-block !important;
    box-shadow: 0 0 8px rgba(0, 214, 89, 0.9) !important;
    flex-shrink: 0 !important;
    animation: live-green-dot-pulse 2.2s infinite ease-in-out !important;
  }

  @keyframes live-green-dot-pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
      box-shadow: 0 0 8px rgba(0, 214, 89, 0.9);
    }
    50% {
      opacity: 0.6;
      transform: scale(0.85);
      box-shadow: 0 0 3px rgba(0, 214, 89, 0.4);
    }
  }

  /* Infinite Seamless Marquee Container */
  .announcement-marquee-wrapper {
    position: relative !important;
    width: 100% !important;
    overflow: hidden !important;
    display: flex !important;
    align-items: center !important;
    white-space: nowrap !important;
  }

  .announcement-marquee-track {
    display: flex !important;
    width: max-content !important;
    will-change: transform !important;
    animation: announcement-marquee-scroll 28s linear infinite !important;
  }

  .announcement-marquee-track:hover {
    animation-play-state: paused !important;
  }

  .announcement-marquee-content {
    display: flex !important;
    align-items: center !important;
    gap: 1.8rem !important;
    padding-right: 1.8rem !important;
    flex-shrink: 0 !important;
    font-family: 'Roboto Condensed', 'Arial Black', -apple-system, BlinkMacSystemFont, sans-serif !important;
    font-size: 0.82rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    color: #ffffff !important;
  }

  .announcement-marquee-content .marquee-star {
    color: #ffffff !important;
    font-size: 0.85rem !important;
    opacity: 0.75 !important;
  }

  .announcement-marquee-content .marquee-link {
    color: #ffffff !important;
    text-decoration: none !important;
    transition: opacity 0.2s ease !important;
  }

  .announcement-marquee-content .marquee-link:hover {
    opacity: 0.75 !important;
  }

  @keyframes announcement-marquee-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.3333333333%);
    }
  }

  @media screen and (max-width: 860px) {
    .announcement-bar {
      height: 34px !important;
      min-height: 34px !important;
    }
    .announcement-marquee-content {
      font-size: 0.75rem !important;
      gap: 1.4rem !important;
      padding-right: 1.4rem !important;
    }
    .announcement-marquee-track {
      animation-duration: 22s !important;
    }
  }
</style>

<div class="announcement-bar color-{{ section.settings.color_scheme }}" role="region" aria-label="Announcements">
  
  <!-- Continuous Infinite Marquee Track (Repeated 3x for Seamless Loop) -->
  <div class="announcement-marquee-wrapper">
    <div class="announcement-marquee-track">
      
      <!-- Content Block 1 -->
      <div class="announcement-marquee-content">
        <span>FREE SHIPPING ACROSS AUSTRALIA</span>
        <span class="marquee-star">✦</span>
        <span>USE CODE ‘LIMITED’ FOR 10% OFF</span>
        <span class="marquee-star">✦</span>
        <a href="/collections/all" class="marquee-link">BROKEN HALO COLLECTION</a>
        <span class="marquee-star">✦</span>
        <span>LIMITED STOCK AVAILABLE</span>
        <span class="marquee-star">✦</span>
      </div>

      <!-- Content Block 2 (Duplicate for Seamless Loop) -->
      <div class="announcement-marquee-content" aria-hidden="true">
        <span>FREE SHIPPING ACROSS AUSTRALIA</span>
        <span class="marquee-star">✦</span>
        <span>USE CODE ‘LIMITED’ FOR 10% OFF</span>
        <span class="marquee-star">✦</span>
        <a href="/collections/all" class="marquee-link">BROKEN HALO COLLECTION</a>
        <span class="marquee-star">✦</span>
        <span>LIMITED STOCK AVAILABLE</span>
        <span class="marquee-star">✦</span>
      </div>

      <!-- Content Block 3 (Duplicate for Seamless Loop) -->
      <div class="announcement-marquee-content" aria-hidden="true">
        <span>FREE SHIPPING ACROSS AUSTRALIA</span>
        <span class="marquee-star">✦</span>
        <span>USE CODE ‘LIMITED’ FOR 10% OFF</span>
        <span class="marquee-star">✦</span>
        <a href="/collections/all" class="marquee-link">BROKEN HALO COLLECTION</a>
        <span class="marquee-star">✦</span>
        <span>LIMITED STOCK AVAILABLE</span>
        <span class="marquee-star">✦</span>
      </div>

    </div>
  </div>

</div>

{% schema %}
{
  "name": "Announcement Bar",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "accent-1",
      "label": "Color scheme"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement"
      }
    ]
  }
}
{% endschema %}
