{%- comment -%}
  Custom Glitch Slogan Section - Milton One & Glitch Transition
{%- endcomment -%}

<div class="glitch-section-wrapper color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width glitch-banner-inner">
    <div class="glitch-banner__left">
      <h2 
        id="GlitchHeading-{{ section.id }}"
        class="glitch-banner__heading milton-font" 
        data-text-1="{{ section.settings.heading_text_1 | escape }}" 
        data-text-2="{{ section.settings.heading_text_2 | escape }}"
      >
        {{ section.settings.heading_text_1 | escape }}
      </h2>
    </div>
  </div>
</div>

<script>
  (function() {
    function initGlitchSection() {
      const heading = document.getElementById('GlitchHeading-{{ section.id }}');
      if (!heading) return;

      const chars = '!@#$%^&*()_+/{}[]|:;<>?~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      let isTransformed = false;
      let isAnimating = false;

      function triggerGlitch(forward) {
        if (isAnimating) return;
        isAnimating = true;

        const targetText = forward ? heading.dataset.text2 : heading.dataset.text1;
        const length = Math.max(heading.textContent.length, targetText.length);
        let iteration = 0;

        heading.classList.add('is-glitching');
        heading.setAttribute('data-text', targetText);

        if (forward) {
          heading.classList.remove('milton-font');
          heading.style.fontFamily = "'Roboto Condensed', sans-serif";
          heading.style.fontWeight = "900";
          heading.style.textTransform = "uppercase";
          heading.style.letterSpacing = "0.08em";
        } else {
          heading.classList.add('milton-font');
          heading.style.fontFamily = "'Milton One', 'Herr Von Muellerhoff', 'Alex Brush', cursive";
          heading.style.fontWeight = "400";
          heading.style.textTransform = "none";
          heading.style.letterSpacing = "0.04em";
        }

        const interval = setInterval(() => {
          let currentString = '';
          for (let i = 0; i < length; i++) {
            if (i < iteration) {
              currentString += targetText[i] || '';
            } else {
              currentString += chars[Math.floor(Math.random() * chars.length)];
            }
          }

          heading.textContent = currentString;
          iteration += 1 / 2;

          if (iteration >= length) {
            clearInterval(interval);
            heading.textContent = targetText;
            setTimeout(() => {
              heading.classList.remove('is-glitching');
              isAnimating = false;
              isTransformed = forward;
            }, 150);
          }
        }, 30);
      }

      // Scroll Event Listener
      function onScrollHandler() {
        const rect = heading.getBoundingClientRect();
        const windowHeight = window.innerHeight || document.documentElement.clientHeight;

        // Trigger glitch forward when scrolled into middle of viewport
        if (rect.top <= windowHeight * 0.55 && !isTransformed && !isAnimating) {
          triggerGlitch(true);
        } else if (rect.top > windowHeight * 0.75 && isTransformed && !isAnimating) {
          triggerGlitch(false);
        }
      }

      window.addEventListener('scroll', onScrollHandler, { passive: true });
      onScrollHandler();

      // Click / Hover backup trigger
      heading.addEventListener('mouseenter', () => {
        if (!isAnimating) triggerGlitch(!isTransformed);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGlitchSection);
    } else {
      initGlitchSection();
    }
  })();
</script>

{% schema %}
{
  "name": "Glitch Slogan Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading_text_1",
      "label": "Initial Slogan (Left)",
      "default": "Me Against Myself"
    },
    {
      "type": "text",
      "id": "heading_text_2",
      "label": "Glitch Target Slogan (Left)",
      "default": "LIMITED STOCK AVAILABLE"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "Accent 1"
        },
        {
          "value": "accent-2",
          "label": "Accent 2"
        },
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        }
      ],
      "default": "background-1",
      "label": "Color Scheme"
    }
  ],
  "presets": [
    {
      "name": "Glitch Slogan Banner"
    }
  ]
}
{% endschema %}
