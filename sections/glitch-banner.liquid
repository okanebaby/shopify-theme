{%- comment -%}
  Custom Glitch Slogan Section - Milton One & Multi-Trigger Scroll Glitch
{%- endcomment -%}

<div class="glitch-section-wrapper color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width glitch-banner-inner">
    <div class="glitch-banner__left">
      <h2 
        id="GlitchHeading-{{ section.id }}"
        class="glitch-banner__heading milton-font" 
        data-text-1="{{ section.settings.heading_text_1 | escape }}" 
        data-text-2="{{ section.settings.heading_text_2 | escape }}"
        data-text="{{ section.settings.heading_text_1 | escape }}"
      >
        {{ section.settings.heading_text_1 | escape }}
      </h2>
    </div>
  </div>
</div>

<script>
  (function() {
    function initGlitch() {
      const heading = document.getElementById('GlitchHeading-{{ section.id }}');
      if (!heading) return;

      const chars = '!@#$%^&*()_+/{}[]|:;<>?~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      let isTransformed = false;
      let isAnimating = false;

      function doGlitchScramble(targetText, callback) {
        if (isAnimating) return;
        isAnimating = true;

        const length = Math.max(heading.textContent.trim().length, targetText.length);
        let iteration = 0;

        heading.classList.add('is-glitching');
        heading.setAttribute('data-text', targetText);

        const interval = setInterval(() => {
          let currentString = '';
          for (let i = 0; i < length; i++) {
            if (i < iteration) {
              currentString += targetText[i] || '';
            } else {
              currentString += chars[Math.floor(Math.random() * chars.length)];
            }
          }

          heading.textContent = currentString;
          iteration += 1 / 2;

          if (iteration >= length) {
            clearInterval(interval);
            heading.textContent = targetText;
            heading.classList.remove('is-glitching');
            isAnimating = false;
            if (callback) callback();
          }
        }, 30);
      }

      function transformTo(toSecondState) {
        if (isAnimating || isTransformed === toSecondState) return;

        const targetText = toSecondState ? heading.dataset.text2 : heading.dataset.text1;

        if (toSecondState) {
          heading.classList.remove('milton-font');
          heading.style.fontFamily = "'Roboto Condensed', sans-serif";
          heading.style.fontWeight = "900";
          heading.style.textTransform = "uppercase";
          heading.style.letterSpacing = "0.08em";
        } else {
          heading.classList.add('milton-font');
          heading.style.fontFamily = "'Milton One', 'Pinyon Script', 'Great Vibes', 'Italianno', cursive";
          heading.style.fontWeight = "400";
          heading.style.textTransform = "none";
          heading.style.letterSpacing = "0.02em";
        }

        doGlitchScramble(targetText, () => {
          isTransformed = toSecondState;
        });
      }

      // 1. IntersectionObserver Trigger
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting && entry.intersectionRatio >= 0.2) {
              transformTo(true);
            } else if (!entry.isIntersecting && entry.boundingClientRect.top > 0) {
              transformTo(false);
            }
          });
        }, { threshold: [0.1, 0.2, 0.5] });
        observer.observe(heading);
      }

      // 2. Direct Window Scroll Listener Fallback
      function checkScroll() {
        const rect = heading.getBoundingClientRect();
        const winHeight = window.innerHeight || document.documentElement.clientHeight;

        if (rect.top <= winHeight * 0.7 && rect.bottom >= 0) {
          transformTo(true);
        } else if (rect.top > winHeight * 0.85) {
          transformTo(false);
        }
      }

      window.addEventListener('scroll', checkScroll, { passive: true });
      checkScroll();

      // 3. Hover / Click Replay
      heading.addEventListener('mouseenter', () => {
        transformTo(!isTransformed);
      });
      heading.addEventListener('click', () => {
        transformTo(!isTransformed);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGlitch);
    } else {
      initGlitch();
    }
  })();
</script>

{% schema %}
{
  "name": "Glitch Slogan Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading_text_1",
      "label": "Initial Slogan (Milton One Font)",
      "default": "Me Against Myself"
    },
    {
      "type": "text",
      "id": "heading_text_2",
      "label": "Glitch Target Slogan",
      "default": "LIMITED STOCK AVAILABLE"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "Accent 1"
        },
        {
          "value": "accent-2",
          "label": "Accent 2"
        },
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        }
      ],
      "default": "background-1",
      "label": "Color Scheme"
    }
  ],
  "presets": [
    {
      "name": "Glitch Slogan Banner"
    }
  ]
}
{% endschema %}
