{%- comment -%}
  Custom Glitch Slogan Section - Milton One & Self-Contained Auto/Scroll Glitch
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Great+Vibes&family=Italianno&family=Monsieur+La+Doulaise&family=MonteCarlo&family=Alex+Brush&display=swap');

  @font-face {
    font-family: 'Milton One Local';
    src: url('https://fonts.cdnfonts.com/s/85257/MiltonOne.woff') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  .glitch-banner-wrapper {
    background-color: #000000 !important;
    border-top: 1px solid #222222 !important;
    border-bottom: 1px solid #222222 !important;
    padding: 5rem 1.5rem !important;
    min-height: 240px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    width: 100% !important;
    box-sizing: border-box !important;
    overflow: hidden !important;
  }

  h2.glitch-heading-text,
  .glitch-heading-text {
    font-family: 'Milton One Local', 'Pinyon Script', 'Great Vibes', 'Italianno', 'Monsieur La Doulaise', cursive !important;
    font-size: clamp(3rem, 7vw, 6.2rem) !important;
    font-weight: 400 !important;
    font-style: normal !important;
    color: #ffffff !important;
    line-height: 1.15 !important;
    margin: 0 !important;
    padding: 0 !important;
    text-transform: none !important;
    letter-spacing: 0.02em !important;
    position: relative !important;
    display: inline-block !important;
    user-select: none !important;
  }

  h2.glitch-heading-text.is-sans,
  .glitch-heading-text.is-sans {
    font-family: 'Roboto Condensed', 'Arial Black', sans-serif !important;
    font-weight: 900 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
  }

  /* Cyber Glitch RGB Split Effects */
  .glitch-heading-text.is-glitching {
    animation: glitch-skew-effect 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) both !important;
  }

  .glitch-heading-text.is-glitching::before,
  .glitch-heading-text.is-glitching::after {
    content: attr(data-text) !important;
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    clip: rect(0, 0, 0, 0) !important;
    font-family: inherit !important;
  }

  .glitch-heading-text.is-glitching::before {
    left: 3px !important;
    text-shadow: -3px 0 #ff0055 !important;
    animation: glitch-split-1 0.25s infinite linear alternate-reverse !important;
  }

  .glitch-heading-text.is-glitching::after {
    left: -3px !important;
    text-shadow: -3px 0 #00e5ff !important;
    animation: glitch-split-2 0.25s infinite linear alternate-reverse !important;
  }

  @keyframes glitch-skew-effect {
    0% { transform: skew(0deg); }
    20% { transform: skew(-3deg); }
    40% { transform: skew(4deg); }
    60% { transform: skew(-2deg); }
    80% { transform: skew(2deg); }
    100% { transform: skew(0deg); }
  }

  @keyframes glitch-split-1 {
    0% { clip: rect(10px, 9999px, 35px, 0); }
    33% { clip: rect(45px, 9999px, 15px, 0); }
    66% { clip: rect(20px, 9999px, 55px, 0); }
    100% { clip: rect(5px, 9999px, 25px, 0); }
  }

  @keyframes glitch-split-2 {
    0% { clip: rect(35px, 9999px, 15px, 0); }
    33% { clip: rect(15px, 9999px, 45px, 0); }
    66% { clip: rect(50px, 9999px, 20px, 0); }
    100% { clip: rect(20px, 9999px, 35px, 0); }
  }
</style>

<div class="glitch-banner-wrapper">
  <div class="page-width">
    <h2 
      id="GlitchHeading-{{ section.id }}"
      class="glitch-heading-text" 
      data-text-1="{{ section.settings.heading_text_1 | escape }}" 
      data-text-2="{{ section.settings.heading_text_2 | escape }}"
      data-text="{{ section.settings.heading_text_1 | escape }}"
    >
      {{ section.settings.heading_text_1 | escape }}
    </h2>
  </div>
</div>

<script>
  (function() {
    function startGlitchController() {
      const heading = document.getElementById('GlitchHeading-{{ section.id }}');
      if (!heading) return;

      const phrase1 = heading.dataset.text1 || "Me Against Myself";
      const phrase2 = heading.dataset.text2 || "LIMITED STOCK AVAILABLE";
      const chars = '!@#$%^&*()_+/{}[]|:;<>?~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      
      let currentState = 1; // 1 = "Me Against Myself", 2 = "LIMITED STOCK AVAILABLE"
      let isAnimating = false;

      function runGlitchTransition(toState) {
        if (isAnimating || currentState === toState) return;
        isAnimating = true;

        const targetText = toState === 2 ? phrase2 : phrase1;
        const length = Math.max(heading.textContent.trim().length, targetText.length);
        let iteration = 0;

        heading.classList.add('is-glitching');
        heading.setAttribute('data-text', targetText);

        if (toState === 2) {
          heading.classList.add('is-sans');
        } else {
          heading.classList.remove('is-sans');
        }

        const timer = setInterval(() => {
          let scramble = '';
          for (let i = 0; i < length; i++) {
            if (i < iteration) {
              scramble += targetText[i] || '';
            } else {
              scramble += chars[Math.floor(Math.random() * chars.length)];
            }
          }
          heading.textContent = scramble;
          iteration += 0.6;

          if (iteration >= length) {
            clearInterval(timer);
            heading.textContent = targetText;
            heading.classList.remove('is-glitching');
            isAnimating = false;
            currentState = toState;
          }
        }, 30);
      }

      // 1. Scroll Position Check
      function checkScrollPosition() {
        const rect = heading.getBoundingClientRect();
        const winHeight = window.innerHeight || document.documentElement.clientHeight;

        if (rect.top <= winHeight * 0.75 && rect.bottom >= 0) {
          if (currentState !== 2) runGlitchTransition(2);
        } else if (rect.top > winHeight * 0.85) {
          if (currentState !== 1) runGlitchTransition(1);
        }
      }

      window.addEventListener('scroll', checkScrollPosition, { passive: true });
      document.addEventListener('scroll', checkScrollPosition, { passive: true });
      checkScrollPosition();

      // 2. Continuous Auto-Loop Fallback (glitches every 3.5s so it's impossible to miss)
      setInterval(() => {
        const nextState = currentState === 1 ? 2 : 1;
        runGlitchTransition(nextState);
      }, 3500);

      // 3. Hover / Click Replay
      heading.addEventListener('mouseenter', () => runGlitchTransition(currentState === 1 ? 2 : 1));
      heading.addEventListener('click', () => runGlitchTransition(currentState === 1 ? 2 : 1));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startGlitchController);
    } else {
      startGlitchController();
    }
  })();
</script>

{% schema %}
{
  "name": "Glitch Slogan Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading_text_1",
      "label": "Initial Slogan (Milton One Font)",
      "default": "Me Against Myself"
    },
    {
      "type": "text",
      "id": "heading_text_2",
      "label": "Glitch Target Slogan",
      "default": "LIMITED STOCK AVAILABLE"
    }
  ],
  "presets": [
    {
      "name": "Glitch Slogan Banner"
    }
  ]
}
{% endschema %}
