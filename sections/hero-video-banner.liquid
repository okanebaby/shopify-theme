{% comment %}
  Full-Width Compact Autoplay Video Hero Banner Section
  Featuring Glitching Text ("Me Against Myself" / "LIMITED STOCK AVAILABLE") & Cursive "Shop Broken Halo Now" Button Overlay
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Great+Vibes&family=Italianno&family=Monsieur+La+Doulaise&family=MonteCarlo&family=Alex+Brush&display=swap');

  @font-face {
    font-family: 'Milton One Local';
    src: url('https://fonts.cdnfonts.com/s/85257/MiltonOne.woff') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  .hero-video-banner-container {
    position: relative !important;
    width: 100% !important;
    overflow: hidden !important;
    background: #ffffff !important;
  }

  /* Spacious Hero Height Ratio (16:8 aspect ratio, max-height 650px) */
  .hero-video-wrapper {
    position: relative !important;
    width: 100% !important;
    aspect-ratio: 16 / 8 !important;
    max-height: 650px !important;
    min-height: 450px !important;
    display: flex !important;
    align-items: flex-end !important;
    justify-content: space-between !important;
  }

  @media screen and (max-width: 749px) {
    .hero-video-wrapper {
      aspect-ratio: 16 / 10 !important;
      min-height: 340px !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      justify-content: flex-end !important;
    }
  }

  /* Glitch Text Element Overlay */
  .hero-glitch-heading {
    font-family: 'Milton One Local', 'Times New Roman', serif !important;
    font-size: clamp(2.2rem, 5vw, 4.5rem) !important;
    color: #000000 !important;
    margin: 0 !important;
    line-height: 1 !important;
    letter-spacing: 0.02em !important;
    text-shadow: 0 0 15px rgba(255, 255, 255, 0.9), 0 2px 10px rgba(0,0,0,0.15) !important;
    transition: color 0.3s ease, font-family 0.3s ease !important;
    user-select: none !important;
    white-space: nowrap !important;
  }

  .hero-glitch-heading.is-sans {
    font-family: 'Roboto Condensed', 'Arial Black', sans-serif !important;
    font-weight: 900 !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
    color: #ff0022 !important;
    text-shadow: 0 0 16px rgba(255, 0, 34, 0.6), 0 2px 10px rgba(0,0,0,0.2) !important;
  }

  /* Center Cursive Button Overlay */
  .hero-cursive-button-box {
    position: absolute !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    z-index: 5 !important;
    text-align: center !important;
    width: 90% !important;
    max-width: 540px !important;
    pointer-events: auto !important;
  }

  .hero-cursive-button {
    display: block !important;
    width: 100% !important;
    padding: 1.2rem 2rem !important;
    background: radial-gradient(ellipse at center, rgba(255,255,255,0.95) 0%, rgba(245,245,245,0.9) 60%, rgba(230,230,230,0.85) 100%) !important;
    color: #000000 !important;
    font-family: 'Pinyon Script', 'Alex Brush', 'Great Vibes', cursive !important;
    font-size: clamp(1.8rem, 3.8vw, 3rem) !important;
    font-weight: 400 !important;
    text-decoration: none !important;
    border-radius: 4px !important;
    box-shadow: 0 0 40px rgba(0,0,0,0.8), 0 0 20px rgba(255,255,255,0.4) !important;
    border: 1px solid rgba(0,0,0,0.15) !important;
    transition: all 0.3s ease !important;
    text-shadow: 0 1px 2px rgba(0,0,0,0.2) !important;
  }

  .hero-cursive-button:hover {
    transform: scale(1.02) !important;
    background: #ffffff !important;
    box-shadow: 0 0 50px rgba(0,0,0,0.9), 0 0 30px rgba(255,255,255,0.6) !important;
  }
</style>

<div class="hero-video-banner-container">
  <div class="hero-video-wrapper">
    
    <video
      autoplay
      loop
      muted
      playsinline
      webkit-playsinline
      preload="auto"
      style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;"
    >
      <source src="{{ 'product-landscape-video.mp4' | asset_url }}" type="video/mp4">
    </video>

    <!-- Smooth Bottom White Gradient Overlay (Fades video seamlessly into pure white background) -->
    <div style="position: absolute; inset: 0; z-index: 2; background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0) 40%, rgba(255,255,255,0.45) 68%, rgba(255,255,255,0.92) 88%, #ffffff 100%); pointer-events: none;"></div>

    <!-- Center Cursive "Shop Broken Halo Now" Button Overlay -->
    <div class="hero-cursive-button-box">
      <a href="/collections/all" class="hero-cursive-button">
        Shop Broken Halo Now
      </a>
    </div>

    <!-- Bottom Left Glitching Heading Overlay -->
    <div style="position: relative; z-index: 4; padding: 2rem 2.5rem; color: #ffffff; max-width: 700px; pointer-events: auto;">
      <h2 
        id="HeroGlitchHeading" 
        class="hero-glitch-heading"
        data-text1="{{ section.settings.heading_text_1 | default: 'Me Against Myself' }}"
        data-text2="{{ section.settings.heading_text_2 | default: 'LIMITED STOCK AVAILABLE' }}"
      >
        {{ section.settings.heading_text_1 | default: "Me Against Myself" }}
      </h2>
    </div>

  </div>
</div>

<script>
  (function() {
    function initHeroGlitch() {
      const heading = document.getElementById('HeroGlitchHeading');
      if (!heading) return;

      const phrase1 = heading.dataset.text1 || "Me Against Myself";
      const phrase2 = heading.dataset.text2 || "LIMITED STOCK AVAILABLE";
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      
      let currentState = 1;
      let isAnimating = false;

      function runGlitch(toState) {
        if (isAnimating || currentState === toState) return;
        isAnimating = true;

        const targetText = toState === 2 ? phrase2 : phrase1;
        const length = Math.max(heading.textContent.trim().length, targetText.length);
        let iteration = 0;

        if (toState === 2) {
          heading.classList.add('is-sans');
        } else {
          heading.classList.remove('is-sans');
        }

        const timer = setInterval(() => {
          let scramble = '';
          for (let i = 0; i < length; i++) {
            if (i < iteration) {
              scramble += targetText[i] || '';
            } else {
              scramble += chars[Math.floor(Math.random() * chars.length)];
            }
          }
          heading.textContent = scramble;
          iteration += 1.2;

          if (iteration >= length) {
            clearInterval(timer);
            heading.textContent = targetText;
            isAnimating = false;
            currentState = toState;
          }
        }, 35);
      }

      // Scroll glitch listener
      let lastScrollY = window.scrollY;
      window.addEventListener('scroll', () => {
        const currentScrollY = window.scrollY;
        if (Math.abs(currentScrollY - lastScrollY) > 15) {
          lastScrollY = currentScrollY;
          runGlitch(currentState === 1 ? 2 : 1);
        }
      }, { passive: true });

      // Auto loop glitch every 5.5s
      setInterval(() => {
        runGlitch(currentState === 1 ? 2 : 1);
      }, 5500);

      heading.addEventListener('mouseenter', () => runGlitch(currentState === 1 ? 2 : 1));
      heading.addEventListener('click', () => runGlitch(currentState === 1 ? 2 : 1));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroGlitch);
    } else {
      initHeroGlitch();
    }
  })();
</script>

{% schema %}
{
  "name": "Hero Video Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading_text_1",
      "label": "Initial Glitch Text",
      "default": "Me Against Myself"
    },
    {
      "type": "text",
      "id": "heading_text_2",
      "label": "Secondary Glitch Text",
      "default": "LIMITED STOCK AVAILABLE"
    }
  ],
  "presets": [
    {
      "name": "Hero Video Banner"
    }
  ]
}
{% endschema %}
