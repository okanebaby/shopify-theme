{% comment %}
  Full-Width Autoplay Video Hero Banner Section
  Features:
  - Exact Milton One script font for "Me Against Myself" (loaded via Milton_One.otf)
  - Original glitch animation timing, transitions, and behavior
  - Crystal-clear 100% unblurred looping video
  - Smooth bottom vertical gradient fade into pure white (#FFFFFF)
  - Center cursive glowing "Shop Broken Halo Now" button
  - Dominant, responsive layout across the white fade horizon
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Great+Vibes&family=Italianno&family=Monsieur+La+Doulaise&family=MonteCarlo&family=Alex+Brush&display=swap');

  @font-face {
    font-family: 'Milton One';
    src: url('{{ "Milton_One.otf" | asset_url }}') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Milton One Local';
    src: url('{{ "Milton_One.otf" | asset_url }}') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Milton_One';
    src: url('{{ "Milton_One.otf" | asset_url }}') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  .hero-video-banner-container {
    position: relative !important;
    width: 100% !important;
    overflow: hidden !important;
    background: #ffffff !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Video Wrapper - Maintains full video clarity and responsive aspect ratio */
  .hero-video-wrapper {
    position: relative !important;
    width: 100% !important;
    aspect-ratio: 16 / 8.5 !important;
    max-height: 680px !important;
    min-height: 460px !important;
    display: flex !important;
    align-items: flex-end !important;
    justify-content: space-between !important;
    overflow: hidden !important;
    background: #ffffff !important;
  }

  @media screen and (max-width: 749px) {
    .hero-video-wrapper {
      aspect-ratio: 16 / 11 !important;
      min-height: 360px !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      justify-content: flex-end !important;
    }
  }

  /* Seamless Bottom White Gradient Overlay */
  /* Starts transparent ~25% before bottom edge, transitions smoothly into solid #FFFFFF */
  .hero-video-wrapper::after {
    content: '' !important;
    position: absolute !important;
    bottom: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 30% !important;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.05) 20%,
      rgba(255, 255, 255, 0.2) 40%,
      rgba(255, 255, 255, 0.5) 65%,
      rgba(255, 255, 255, 0.85) 85%,
      #ffffff 100%
    ) !important;
    pointer-events: none !important;
    z-index: 2 !important;
  }

  /* Glitch Text Element Overlay (Bottom Left) - Matches Password Page Script & Thick Glow */
  #HeroGlitchHeading,
  .hero-glitch-heading {
    font-family: 'Pinyon Script', 'Great Vibes', 'Milton One Local', cursive !important;
    font-size: clamp(3.2rem, 8vw, 7.5rem) !important;
    color: #000000 !important;
    margin: 0 !important;
    line-height: 1 !important;
    letter-spacing: 0.02em !important;
    text-shadow: 0 0 4px #000000, 0 0 14px rgba(0, 0, 0, 0.85), 0 0 28px rgba(0, 0, 0, 0.55) !important;
    transition: all 0.3s ease !important;
    user-select: none !important;
    white-space: nowrap !important;
    cursor: pointer !important;
    font-style: normal !important;
    font-weight: 400 !important;
  }

  #HeroGlitchHeading.is-sans,
  .hero-glitch-heading.is-sans {
    font-family: 'Roboto Condensed', 'Arial Black', sans-serif !important;
    font-weight: 900 !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
    color: #ff0022 !important;
    text-shadow: 0 0 16px rgba(255, 0, 34, 0.6), 0 2px 8px rgba(0, 0, 0, 0.2) !important;
  }

  @media screen and (max-width: 749px) {
    #HeroGlitchHeading,
    .hero-glitch-heading {
      font-size: clamp(2.2rem, 9vw, 3.6rem) !important;
      white-space: normal !important;
    }
  }

  /* Center Cursive Button Overlay with Glowing White Aura */
  .hero-cursive-button-box {
    position: absolute !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    z-index: 5 !important;
    text-align: center !important;
    width: 90% !important;
    max-width: 600px !important;
    pointer-events: auto !important;
  }

  .hero-cursive-button {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 14px 28px !important;
    background: transparent !important;
    background-color: transparent !important;
    color: #000000 !important;
    text-decoration: none !important;
    border: none !important;
    box-shadow: none !important;
    font-family: 'Milton One', 'Milton One Local', 'Pinyon Script', 'Great Vibes', 'Italianno', 'Monsieur La Doulaise', cursive !important;
    font-size: clamp(2.4rem, 6vw, 4.8rem) !important;
    font-weight: 400 !important;
    text-transform: none !important;
    letter-spacing: 0.02em !important;
    white-space: nowrap !important;
    position: relative !important;
    z-index: 3 !important;
    text-shadow: 
      0 0 2px #000000,
      0 0 8px rgba(0, 0, 0, 0.9),
      0 0 18px #ffffff,
      0 0 35px #ffffff,
      0 0 55px rgba(255, 255, 255, 1) !important;
    transition: transform 0.3s ease, text-shadow 0.3s ease !important;
  }

  .hero-cursive-button::before {
    content: '' !important;
    position: absolute !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    width: 140% !important;
    height: 190% !important;
    background: radial-gradient(ellipse at center, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.7) 50%, transparent 85%) !important;
    filter: blur(28px) !important;
    z-index: -1 !important;
    pointer-events: none !important;
    border-radius: 50% !important;
  }

  .hero-cursive-button:hover {
    transform: scale(1.06) !important;
    text-shadow: 
      0 0 4px #000000,
      0 0 12px #000000,
      0 0 25px #ffffff,
      0 0 45px #ffffff,
      0 0 65px rgba(255, 255, 255, 1) !important;
  }
</style>

<div class="hero-video-banner-container">
  <div class="hero-video-wrapper">
    
    <!-- Video Player (100% unblurred and unedited) -->
    <video
      autoplay
      loop
      muted
      playsinline
      webkit-playsinline
      preload="auto"
      style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;"
    >
      <source src="{{ 'product-landscape-video.mp4' | asset_url }}" type="video/mp4">
    </video>

    <!-- Center Cursive "Shop Broken Halo Now" Button Overlay -->
    <div class="hero-cursive-button-box">
      <a href="/collections/all" class="hero-cursive-button">
        Shop Broken Halo Now
      </a>
    </div>

    <!-- Bottom Left Glitching Heading Overlay (Milton One Script Font) -->
    <div style="position: relative; z-index: 4; padding: 2rem 2.5rem; max-width: 800px; pointer-events: auto;">
      <h2 
        id="HeroGlitchHeading" 
        class="hero-glitch-heading"
        data-text1="{{ section.settings.heading_text_1 | default: 'Me Against Myself' }}"
        data-text2="{{ section.settings.heading_text_2 | default: 'LIMITED STOCK AVAILABLE' }}"
      >
        {{ section.settings.heading_text_1 | default: "Me Against Myself" }}
      </h2>
    </div>

  </div>
</div>

<script>
  (function() {
    function initHeroGlitch() {
      const heading = document.getElementById('HeroGlitchHeading');
      if (!heading) return;

      const phrase1 = heading.dataset.text1 || "Me Against Myself";
      const phrase2 = heading.dataset.text2 || "LIMITED STOCK AVAILABLE";
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      
      let currentState = 1;
      let isAnimating = false;

      function runGlitch(toState) {
        if (isAnimating || currentState === toState) return;
        isAnimating = true;

        const targetText = toState === 2 ? phrase2 : phrase1;
        const length = Math.max(heading.textContent.trim().length, targetText.length);
        let iteration = 0;

        if (toState === 2) {
          heading.classList.add('is-sans');
          heading.style.setProperty('font-family', "'Roboto Condensed', 'Arial Black', sans-serif", 'important');
        } else {
          heading.classList.remove('is-sans');
          heading.style.setProperty('font-family', "'Pinyon Script', 'Great Vibes', 'Milton One Local', cursive", 'important');
        }

        const timer = setInterval(() => {
          let scramble = '';
          for (let i = 0; i < length; i++) {
            if (i < iteration) {
              scramble += targetText[i] || '';
            } else {
              scramble += chars[Math.floor(Math.random() * chars.length)];
            }
          }
          heading.textContent = scramble;
          iteration += 1.2;

          if (iteration >= length) {
            clearInterval(timer);
            heading.textContent = targetText;
            isAnimating = false;
            currentState = toState;
          }
        }, 35);
      }

      // Scroll glitch listener
      let lastScrollY = window.scrollY;
      window.addEventListener('scroll', () => {
        const currentScrollY = window.scrollY;
        if (Math.abs(currentScrollY - lastScrollY) > 15) {
          lastScrollY = currentScrollY;
          runGlitch(currentState === 1 ? 2 : 1);
        }
      }, { passive: true });

      // Auto loop glitch every 5.5s
      setInterval(() => {
        runGlitch(currentState === 1 ? 2 : 1);
      }, 5500);

      heading.addEventListener('mouseenter', () => runGlitch(currentState === 1 ? 2 : 1));
      heading.addEventListener('click', () => runGlitch(currentState === 1 ? 2 : 1));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroGlitch);
    } else {
      initHeroGlitch();
    }
  })();
</script>

{% schema %}
{
  "name": "Hero Video Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading_text_1",
      "label": "Initial Glitch Text",
      "default": "Me Against Myself"
    },
    {
      "type": "text",
      "id": "heading_text_2",
      "label": "Secondary Glitch Text",
      "default": "LIMITED STOCK AVAILABLE"
    }
  ],
  "presets": [
    {
      "name": "Hero Video Banner"
    }
  ]
}
{% endschema %}
