{% comment %}
  Render "FIND MY SIZE" Fit Quiz Modal (worstwork.com style)
{% endcomment %}

<div class="fit-quiz-trigger-container" style="margin: 1.2rem 0 0.8rem 0;">
  <button
    type="button"
    id="open-fit-quiz-btn"
    class="fit-quiz-open-btn"
    style="
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      max-width: 320px;
      padding: 0.75rem 1.4rem;
      background: #ffffff;
      color: #000000;
      border: 2px solid #000000;
      border-radius: 4px;
      font-family: 'Roboto Condensed', 'Arial Black', sans-serif;
      font-weight: 900;
      font-size: 1.3rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15);
    "
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.47a1 1 0 00.99.84H6v10a2 2 0 002 2h8a2 2 0 002-2V10h2.15a1 1 0 00.99-.84l.58-3.47a2 2 0 00-1.34-2.23z"/>
    </svg>
    <span>FIND MY SIZE</span>
  </button>
</div>

<!-- Modal Overlay -->
<div id="fit-quiz-modal" class="fit-quiz-modal-overlay" style="display: none; position: fixed; inset: 0; z-index: 999999; background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(6px); align-items: center; justify-content: center; padding: 1rem;">
  <div class="fit-quiz-modal-card" style="background: #ffffff; color: #000000; width: 100%; max-width: 540px; border-radius: 16px; padding: 2rem 1.8rem 1.5rem 1.8rem; position: relative; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4); font-family: 'Times New Roman', Times, serif;">
    
    <!-- Modal Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; position: relative; margin-bottom: 1.5rem;">
      <button type="button" id="fit-quiz-back-btn" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; padding: 4px; visibility: hidden; color: #333333;">
        &larr;
      </button>
      <div style="font-size: 0.95rem; font-weight: 700; color: #667788; text-transform: uppercase; letter-spacing: 0.05em; font-family: sans-serif;">
        Take our Fit quiz
      </div>
      <button type="button" id="fit-quiz-close-btn" style="background: none; border: none; font-size: 1.6rem; cursor: pointer; padding: 4px; color: #333333; line-height: 1;">
        &times;
      </button>
    </div>

    <!-- Step 1: Usual Top Size -->
    <div id="fit-quiz-step-1" class="fit-quiz-step-view">
      <h3 style="font-family: 'Roboto Condensed', 'Arial Black', sans-serif; font-size: 1.65rem; font-weight: 900; text-align: center; margin: 0 0 1.8rem 0; color: #111111;">
        What top size do you usually wear?
      </h3>
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 2rem;">
        <button type="button" class="fit-quiz-opt-btn" data-step="1" data-val="2XS" style="padding: 1.2rem 0.5rem; border: 1.5px solid #dcdcdc; border-radius: 10px; background: #ffffff; font-family: 'Roboto Condensed', sans-serif; font-size: 1.15rem; font-weight: 900; cursor: pointer; transition: all 0.2s ease;">2XS</button>
        <button type="button" class="fit-quiz-opt-btn" data-step="1" data-val="XS" style="padding: 1.2rem 0.5rem; border: 1.5px solid #dcdcdc; border-radius: 10px; background: #ffffff; font-family: 'Roboto Condensed', sans-serif; font-size: 1.15rem; font-weight: 900; cursor: pointer; transition: all 0.2s ease;">XS</button>
        <button type="button" class="fit-quiz-opt-btn" data-step="1" data-val="S" style="padding: 1.2rem 0.5rem; border: 1.5px solid #dcdcdc; border-radius: 10px; background: #ffffff; font-family: 'Roboto Condensed', sans-serif; font-size: 1.15rem; font-weight: 900; cursor: pointer; transition: all 0.2s ease;">S</button>
        <button type="button" class="fit-quiz-opt-btn" data-step="1" data-val="M" style="padding: 1.2rem 0.5rem; border: 1.5px solid #dcdcdc; border-radius: 10px; background: #ffffff; font-family: 'Roboto Condensed', sans-serif; font-size: 1.15rem; font-weight: 900; cursor: pointer; transition: all 0.2s ease;">M</button>
        <button type="button" class="fit-quiz-opt-btn" data-step="1" data-val="L" style="padding: 1.2rem 0.5rem; border: 1.5px solid #dcdcdc; border-radius: 10px; background: #ffffff; font-family: 'Roboto Condensed', sans-serif; font-size: 1.15rem; font-weight: 900; cursor: pointer; transition: all 0.2s ease;">L</button>
        <button type="button" class="fit-quiz-opt-btn" data-step="1" data-val="XL" style="padding: 1.2rem 0.5rem; border: 1.5px solid #dcdcdc; border-radius: 10px; background: #ffffff; font-family: 'Roboto Condensed', sans-serif; font-size: 1.15rem; font-weight: 900; cursor: pointer; transition: all 0.2s ease;">XL</button>
        <button type="button" class="fit-quiz-opt-btn" data-step="1" data-val="2XL" style="padding: 1.2rem 0.5rem; border: 1.5px solid #dcdcdc; border-radius: 10px; background: #ffffff; font-family: 'Roboto Condensed', sans-serif; font-size: 1.15rem; font-weight: 900; cursor: pointer; transition: all 0.2s ease;">2XL</button>
        <button type="button" class="fit-quiz-opt-btn" data-step="1" data-val="3XL" style="padding: 1.2rem 0.5rem; border: 1.5px solid #dcdcdc; border-radius: 10px; background: #ffffff; font-family: 'Roboto Condensed', sans-serif; font-size: 1.15rem; font-weight: 900; cursor: pointer; transition: all 0.2s ease;">3XL</button>
      </div>
      <div style="text-align: center; font-size: 0.9rem; font-weight: 600; color: #556677; font-family: sans-serif; border-top: 1px solid #eeeeee; padding-top: 1rem;">
        Step 1/3
      </div>
    </div>

    <!-- Step 2: Fit Preference -->
    <div id="fit-quiz-step-2" class="fit-quiz-step-view" style="display: none;">
      <h3 style="font-family: 'Roboto Condensed', 'Arial Black', sans-serif; font-size: 1.65rem; font-weight: 900; text-align: center; margin: 0 0 1.8rem 0; color: #111111;">
        How do you like your fit?
      </h3>
      <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 2rem;">
        <button type="button" class="fit-quiz-opt-btn" data-step="2" data-val="slim" style="padding: 1rem 1.2rem; border: 1.5px solid #dcdcdc; border-radius: 10px; background: #ffffff; font-family: 'Roboto Condensed', sans-serif; font-size: 1.15rem; font-weight: 900; cursor: pointer; text-align: left; display: flex; justify-content: space-between; align-items: center; transition: all 0.2s ease;">
          <span>Slim / Tailored</span>
          <span style="font-size: 0.9rem; color: #777777; font-weight: normal;">Snug fit</span>
        </button>
        <button type="button" class="fit-quiz-opt-btn" data-step="2" data-val="regular" style="padding: 1rem 1.2rem; border: 1.5px solid #dcdcdc; border-radius: 10px; background: #ffffff; font-family: 'Roboto Condensed', sans-serif; font-size: 1.15rem; font-weight: 900; cursor: pointer; text-align: left; display: flex; justify-content: space-between; align-items: center; transition: all 0.2s ease;">
          <span>Standard / Regular</span>
          <span style="font-size: 0.9rem; color: #777777; font-weight: normal;">True to size</span>
        </button>
        <button type="button" class="fit-quiz-opt-btn" data-step="2" data-val="oversized" style="padding: 1rem 1.2rem; border: 1.5px solid #dcdcdc; border-radius: 10px; background: #ffffff; font-family: 'Roboto Condensed', sans-serif; font-size: 1.15rem; font-weight: 900; cursor: pointer; text-align: left; display: flex; justify-content: space-between; align-items: center; transition: all 0.2s ease;">
          <span>Baggy / Oversized</span>
          <span style="font-size: 0.9rem; color: #777777; font-weight: normal;">Relaxed streetwear fit</span>
        </button>
      </div>
      <div style="text-align: center; font-size: 0.9rem; font-weight: 600; color: #556677; font-family: sans-serif; border-top: 1px solid #eeeeee; padding-top: 1rem;">
        Step 2/3
      </div>
    </div>

    <!-- Step 3: Height & Build -->
    <div id="fit-quiz-step-3" class="fit-quiz-step-view" style="display: none;">
      <h3 style="font-family: 'Roboto Condensed', 'Arial Black', sans-serif; font-size: 1.65rem; font-weight: 900; text-align: center; margin: 0 0 1.8rem 0; color: #111111;">
        What is your height & body build?
      </h3>
      <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 2rem;">
        <button type="button" class="fit-quiz-opt-btn" data-step="3" data-val="lean" style="padding: 1rem 1.2rem; border: 1.5px solid #dcdcdc; border-radius: 10px; background: #ffffff; font-family: 'Roboto Condensed', sans-serif; font-size: 1.15rem; font-weight: 900; cursor: pointer; text-align: left; display: flex; justify-content: space-between; align-items: center; transition: all 0.2s ease;">
          <span>Lean / Slim Frame</span>
          <span style="font-size: 0.9rem; color: #777777; font-weight: normal;">Under 150 lbs</span>
        </button>
        <button type="button" class="fit-quiz-opt-btn" data-step="3" data-val="average" style="padding: 1rem 1.2rem; border: 1.5px solid #dcdcdc; border-radius: 10px; background: #ffffff; font-family: 'Roboto Condensed', sans-serif; font-size: 1.15rem; font-weight: 900; cursor: pointer; text-align: left; display: flex; justify-content: space-between; align-items: center; transition: all 0.2s ease;">
          <span>Average / Medium Build</span>
          <span style="font-size: 0.9rem; color: #777777; font-weight: normal;">150 - 180 lbs</span>
        </button>
        <button type="button" class="fit-quiz-opt-btn" data-step="3" data-val="athletic" style="padding: 1rem 1.2rem; border: 1.5px solid #dcdcdc; border-radius: 10px; background: #ffffff; font-family: 'Roboto Condensed', sans-serif; font-size: 1.15rem; font-weight: 900; cursor: pointer; text-align: left; display: flex; justify-content: space-between; align-items: center; transition: all 0.2s ease;">
          <span>Broad / Muscular Build</span>
          <span style="font-size: 0.9rem; color: #777777; font-weight: normal;">180+ lbs</span>
        </button>
      </div>
      <div style="text-align: center; font-size: 0.9rem; font-weight: 600; color: #556677; font-family: sans-serif; border-top: 1px solid #eeeeee; padding-top: 1rem;">
        Step 3/3
      </div>
    </div>

    <!-- Step 4: Result Recommendation -->
    <div id="fit-quiz-step-4" class="fit-quiz-step-view" style="display: none; text-align: center;">
      <div style="font-size: 3rem; margin-bottom: 0.5rem;">🎯</div>
      <h3 style="font-family: 'Roboto Condensed', 'Arial Black', sans-serif; font-size: 1.6rem; font-weight: 900; margin: 0 0 0.5rem 0; color: #111111;">
        Your Recommended Fit
      </h3>
      <p style="font-family: 'Times New Roman', Times, serif; font-style: italic; font-weight: 700; font-size: 1.2rem; color: #444444; margin-bottom: 1.5rem;">
        Based on your profile, we recommend:
      </p>

      <div style="display: inline-block; background: #000000; color: #ffffff; padding: 1rem 2.5rem; border-radius: 12px; border: 2px solid #ff0022; box-shadow: 0 0 20px rgba(255, 0, 34, 0.4); margin-bottom: 2rem;">
        <div style="font-family: 'Roboto Condensed', sans-serif; font-size: 0.9rem; font-weight: 900; color: #ff0022; text-transform: uppercase; letter-spacing: 0.1em;">BEST MATCH</div>
        <div id="fit-recommended-size" style="font-family: 'Roboto Condensed', sans-serif; font-size: 2.8rem; font-weight: 900; letter-spacing: 0.05em; text-shadow: -1px 0 0 #000, 1px 0 0 #ff0022;">
          MEDIUM
        </div>
      </div>

      <div>
        <button type="button" id="fit-quiz-select-size-btn" style="width: 100%; padding: 1.1rem; background: #000000; color: #ffffff; border: none; border-radius: 8px; font-family: 'Roboto Condensed', sans-serif; font-weight: 900; font-size: 1.25rem; text-transform: uppercase; letter-spacing: 0.06em; cursor: pointer; transition: all 0.2s ease;">
          SELECT SIZE & CONTINUE
        </button>
      </div>
    </div>

  </div>
</div>

<script>
  (function() {
    const modal = document.getElementById('fit-quiz-modal');
    const openBtn = document.getElementById('open-fit-quiz-btn');
    const closeBtn = document.getElementById('fit-quiz-close-btn');
    const backBtn = document.getElementById('fit-quiz-back-btn');
    const selectBtn = document.getElementById('fit-quiz-select-size-btn');
    const recSizeDisplay = document.getElementById('fit-recommended-size');

    let currentStep = 1;
    let quizData = { size: 'M', fit: 'regular', build: 'average' };

    function showStep(step) {
      currentStep = step;
      document.querySelectorAll('.fit-quiz-step-view').forEach(el => el.style.display = 'none');
      const target = document.getElementById('fit-quiz-step-' + step);
      if (target) target.style.display = 'block';

      if (step > 1 && step < 4) {
        backBtn.style.visibility = 'visible';
      } else {
        backBtn.style.visibility = 'hidden';
      }

      if (step === 4) {
        calculateRecommendation();
      }
    }

    function calculateRecommendation() {
      let finalSize = quizData.size || 'M';

      if (quizData.fit === 'oversized') {
        const sizes = ['2XS', 'XS', 'S', 'M', 'L', 'XL', '2XL', '3XL'];
        const idx = sizes.indexOf(finalSize);
        if (idx !== -1 && idx < sizes.length - 1) {
          finalSize = sizes[idx + 1];
        }
      } else if (quizData.fit === 'slim') {
        const sizes = ['2XS', 'XS', 'S', 'M', 'L', 'XL', '2XL', '3XL'];
        const idx = sizes.indexOf(finalSize);
        if (idx > 0) {
          finalSize = sizes[idx - 1];
        }
      }

      recSizeDisplay.textContent = finalSize;
      recSizeDisplay.setAttribute('data-target-size', finalSize);
    }

    if (openBtn) {
      openBtn.addEventListener('click', () => {
        modal.style.display = 'flex';
        showStep(1);
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        modal.style.display = 'none';
      });
    }

    if (backBtn) {
      backBtn.addEventListener('click', () => {
        if (currentStep > 1) showStep(currentStep - 1);
      });
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.style.display = 'none';
      });
    }

    document.querySelectorAll('.fit-quiz-opt-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const step = parseInt(this.getAttribute('data-step'), 10);
        const val = this.getAttribute('data-val');

        if (step === 1) quizData.size = val;
        if (step === 2) quizData.fit = val;
        if (step === 3) quizData.build = val;

        showStep(step + 1);
      });
    });

    if (selectBtn) {
      selectBtn.addEventListener('click', () => {
        const size = recSizeDisplay.getAttribute('data-target-size') || 'M';
        
        const labels = document.querySelectorAll('.product-form__input label');
        let matched = false;
        labels.forEach(label => {
          if (label.textContent.trim().toUpperCase() === size.toUpperCase()) {
            label.click();
            matched = true;
          }
        });

        if (!matched && labels.length > 0) {
          labels[0].click();
        }

        modal.style.display = 'none';
      });
    }
  })();
</script>
