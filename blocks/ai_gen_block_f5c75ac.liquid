{% doc %}
  @prompt
    in the section I have chosen add my products
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    padding: 30px 0 60px;
    background-color: #ffffff;
  }

  .ai-product-grid-container-{{ ai_gen_id }} {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .ai-product-grid-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment | default: 'center' }};
    margin-bottom: 24px;
  }

  .ai-product-grid-title-{{ ai_gen_id }} {
    font-family: 'Roboto Condensed', 'Arial Black', sans-serif !important;
    font-size: clamp(1.8rem, 3.5vw, 2.5rem) !important;
    font-weight: 800 !important;
    letter-spacing: -0.01em !important;
    text-transform: uppercase !important;
    color: #000000 !important;
    margin: 0 0 8px !important;
  }

  .ai-product-grid-description-{{ ai_gen_id }} {
    font-family: 'Roboto Condensed', 'Helvetica Neue', sans-serif !important;
    font-size: 15px !important;
    color: #555555 !important;
    margin: 0 !important;
  }

  .ai-product-grid-items-{{ ai_gen_id }} {
    display: flex !important;
    flex-wrap: wrap !important;
    justify-content: center !important;
    gap: 32px !important;
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }

  .ai-product-card-{{ ai_gen_id }} {
    display: flex !important;
    flex-direction: column !important;
    background-color: transparent !important;
    width: 100% !important;
    max-width: 460px !important;
    min-width: 280px !important;
    border-radius: 0px !important;
    overflow: hidden !important;
    transition: transform 0.25s ease !important;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-3px) !important;
  }

  .ai-product-card-link-{{ ai_gen_id }} {
    text-decoration: none !important;
    color: inherit !important;
    display: flex !important;
    flex-direction: column !important;
    height: 100% !important;
  }

  /* Large, dominant product image viewport with 80-90% clothing scale */
  .ai-product-image-wrapper-{{ ai_gen_id }} {
    position: relative !important;
    width: 100% !important;
    padding-bottom: 128% !important;
    overflow: hidden !important;
    background-color: transparent !important;
  }

  .ai-product-image-primary-{{ ai_gen_id }} {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
    transform: scale(1.04) !important;
    transition: opacity 0.22s ease-in-out, transform 0.3s ease !important;
    z-index: 1 !important;
  }

  .ai-product-image-secondary-{{ ai_gen_id }} {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
    transform: scale(1.04) !important;
    opacity: 0 !important;
    transition: opacity 0.22s ease-in-out, transform 0.3s ease !important;
    z-index: 2 !important;
  }

  @media (hover: hover) {
    .ai-product-card-{{ ai_gen_id }}:hover .ai-product-image-secondary-{{ ai_gen_id }} {
      opacity: 1 !important;
    }
    .ai-product-card-{{ ai_gen_id }}:hover .ai-product-image-primary-{{ ai_gen_id }} {
      opacity: 0 !important;
    }
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    background-color: #f9f9f9 !important;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60% !important;
    height: 60% !important;
    opacity: 0.3 !important;
  }

  /* Minimal badge with thin rectangular border */
  .ai-product-badge-{{ ai_gen_id }} {
    position: absolute !important;
    top: 12px !important;
    left: 12px !important;
    background: #ffffff !important;
    border: 1px solid #000000 !important;
    color: #000000 !important;
    padding: 3px 8px !important;
    border-radius: 2px !important;
    font-family: 'Roboto Condensed', 'Arial Black', sans-serif !important;
    font-size: 0.72rem !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.1em !important;
    z-index: 3 !important;
    box-shadow: none !important;
  }

  /* Product details with tight intentional gap */
  .ai-product-info-{{ ai_gen_id }} {
    padding: 14px 4px 0 4px !important;
    flex-grow: 1 !important;
    display: flex !important;
    flex-direction: column !important;
    background: transparent !important;
  }

  .ai-product-vendor-{{ ai_gen_id }} {
    font-family: 'Roboto Condensed', sans-serif !important;
    font-size: 0.75rem !important;
    color: #888888 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    margin-bottom: 3px !important;
  }

  /* Bold Condensed Streetwear Title */
  .ai-product-title-{{ ai_gen_id }} {
    font-family: 'Roboto Condensed', 'Helvetica Neue', 'Arial Black', sans-serif !important;
    font-size: clamp(1.15rem, 2.2vw, 1.45rem) !important;
    font-weight: 800 !important;
    color: #000000 !important;
    margin: 0 0 6px !important;
    line-height: 1.2 !important;
    letter-spacing: 0.03em !important;
    text-transform: uppercase !important;
  }

  /* Distinct Clean Price */
  .ai-product-price-{{ ai_gen_id }} {
    font-family: 'Roboto Condensed', 'Helvetica Neue', sans-serif !important;
    font-size: 1.05rem !important;
    font-weight: 600 !important;
    color: #222222 !important;
    letter-spacing: 0.02em !important;
    margin-top: 0 !important;
  }

  .ai-product-price-compare-{{ ai_gen_id }} {
    font-size: 0.95rem !important;
    color: #888888 !important;
    text-decoration: line-through !important;
    margin-left: 8px !important;
    font-weight: 400 !important;
  }

  .ai-product-grid-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-product-grid-empty-{{ ai_gen_id }} p {
    font-size: 16px;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-product-card-{{ ai_gen_id }} {
      max-width: 100% !important;
    }
  }
{% endstyle %}

<product-grid-{{ ai_gen_id }} class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-grid-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.description != blank %}
      <div class="ai-product-grid-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-product-grid-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-product-grid-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.products.count > 0 %}
      <ul class="ai-product-grid-items-{{ ai_gen_id }}">
        {% for product in block.settings.products limit: block.settings.products_to_show %}
          <li class="ai-product-card-{{ ai_gen_id }}">
            <a href="{{ product.url }}" class="ai-product-card-link-{{ ai_gen_id }}">
              <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 900 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-product-image-primary-{{ ai_gen_id }}"
                    loading="lazy"
                    width="900"
                    height="1150"
                  >
                  {% if product.images.size > 1 %}
                    <img
                      src="{{ product.images[1] | image_url: width: 900 }}"
                      alt="{{ product.images[1].alt | escape }}"
                      class="ai-product-image-secondary-{{ ai_gen_id }}"
                      loading="lazy"
                      width="900"
                      height="1150"
                    >
                  {% endif %}
                {% else %}
                  <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if product.compare_at_price > product.price %}
                  <span class="ai-product-badge-{{ ai_gen_id }}">Sale</span>
                {% endif %}
              </div>

              <div class="ai-product-info-{{ ai_gen_id }}">
                {% if block.settings.show_vendor and product.vendor != blank %}
                  <div class="ai-product-vendor-{{ ai_gen_id }}">{{ product.vendor }}</div>
                {% endif %}

                <h3 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>

                <div class="ai-product-price-{{ ai_gen_id }}">
                  {{ product.price | money }}
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-product-price-compare-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                </div>
              </div>
            </a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="ai-product-grid-empty-{{ ai_gen_id }}">
        <p>Next, add products to display in this grid</p>
      </div>
    {% endif %}
  </div>
</product-grid-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Featured Products Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    }
  ],
  "presets": [
    {
      "name": "Featured Products Grid"
    }
  ]
}
{% endschema %}
