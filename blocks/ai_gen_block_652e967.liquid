{% doc %}
  @prompt
    Add big bold text in capital letters which says 'LIMITED STOCK AVAILABLE.", MAKe it scrolling
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-limited-stock-text-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
  }

  .ai-limited-stock-text__content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    padding: {{ block.settings.padding_vertical }}px 0;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-limited-stock-text__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    animation: ai-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-limited-stock-text__message-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    color: {{ block.settings.text_color }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-transform: uppercase;
    margin: 0;
    white-space: nowrap;
    padding: 0 {{ block.settings.padding_horizontal }}px;
  }

  @keyframes ai-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ai-limited-stock-text__track-{{ ai_gen_id }}:hover {
    animation-play-state: {{ block.settings.pause_on_hover }};
  }

  @media screen and (max-width: 749px) {
    .ai-limited-stock-text__message-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.font_size }}px * 0.8);
    }
  }
{% endstyle %}

<div class="ai-limited-stock-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-limited-stock-text__content-{{ ai_gen_id }}">
    <div class="ai-limited-stock-text__track-{{ ai_gen_id }}">
      {% for i in (1..10) %}
        <p class="ai-limited-stock-text__message-{{ ai_gen_id }}">
          {{ block.settings.text }}
        </p>
      {% endfor %}
      {% for i in (1..10) %}
        <p class="ai-limited-stock-text__message-{{ ai_gen_id }}">
          {{ block.settings.text }}
        </p>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Scrolling stock text",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "LIMITED STOCK AVAILABLE"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "900",
          "label": "Extra bold"
        }
      ],
      "default": "900"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Scroll settings"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "s",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between text",
      "min": 20,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "select",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "options": [
        {
          "value": "paused",
          "label": "Yes"
        },
        {
          "value": "running",
          "label": "No"
        }
      ],
      "default": "paused"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#d82c0d"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Scrolling stock text"
    }
  ]
}
{% endschema %}
