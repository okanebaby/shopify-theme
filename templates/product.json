          "settings": {
            "custom_liquid": "<!-- Place this HTML where you want the counter to appear -->\n<div id=\"viewer-counter-box\" style=\"font-family: sans-serif; font-size: 14px; margin: 10px 0; color: #333;\">\n  🔥 <span id=\"viewer-count\">...</span> people are viewing this product right now!\n</div>\n\n<script>\n(function() {\n  // CONFIGURATION: Set your preferred range\n  const MIN_VIEWERS = 7;\n  const MAX_VIEWERS = 28;\n  \n  const countElement = document.getElementById('viewer-count');\n  \n  // Helper to get a random number between min and max\n  function getRandomInt(min, max) {\n    return Math.floor(Math.random() * (max - min + 1)) + min;\n  }\n\n  // Get a unique key for this specific product page\n  const pageKey = 'viewers_' + window.location.pathname;\n  \n  // Try to load a previously saved number for this page session\n  let currentViewers = sessionStorage.getItem(pageKey);\n  \n  if (!currentViewers) {\n    currentViewers = getRandomInt(MIN_VIEWERS, MAX_VIEWERS);\n    sessionStorage.setItem(pageKey, currentViewers);\n  } else {\n    currentViewers = parseInt(currentViewers, 10);\n  }\n  \n  // Show the initial count\n  countElement.textContent = currentViewers;\n\n  // Make the number fluctuate dynamically every 4 to 8 seconds\n  setInterval(function() {\n    // Randomly choose to add 1, subtract 1, or stay the same\n    const change = getRandomInt(-1, 1);\n    currentViewers += change;\n    \n    // Keep the number strictly within your min/max boundaries\n    if (currentViewers < MIN_VIEWERS) currentViewers = MIN_VIEWERS;\n    if (currentViewers > MAX_VIEWERS) currentViewers = MAX_VIEWERS;\n    \n    // Save and update the display\n    sessionStorage.setItem(pageKey, currentViewers);\n    countElement.textContent = currentViewers;\n  }, getRandomInt(4000, 8000));\n})();\n</script>"
