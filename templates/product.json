gba(255, 0, 34, 0.6); box-shadow: 0 0 20px rgba(255, 0, 34, 0.25); }\n  }\n\n  @keyframes liveDotPulse {\n    0% { transform: scale(0.9); opacity: 0.7; }\n    50% { transform: scale(1.4); opacity: 1; }\n    100% { transform: scale(0.9); opacity: 0.7; }\n  }\n\n  @keyframes flameShake {\n    0% { transform: rotate(0deg); }\n    50% { transform: rotate(-8deg) scale(1.1); }\n    100% { transform: rotate(8deg) scale(1); }\n  }\n</style>\n\n<script>\n(function() {\n  const MIN_VIEWERS = 18;\n  const MAX_VIEWERS = 42;\n  const countElement = document.getElementById('viewer-count');\n  if (!countElement) return;\n\n  function getRandomInt(min, max) {\n    return Math.floor(Math.random() * (max - min + 1)) + min;\n  }\n\n  const pageKey = 'viewers_' + window.location.pathname;\n  let currentViewers = sessionStorage.getItem(pageKey);\n  \n  if (!currentViewers) {\n    currentViewers = getRandomInt(MIN_VIEWERS, MAX_VIEWERS);\n    sessionStorage.setItem(pageKey, currentViewers);\n  } else {\n    currentViewers = parseInt(currentViewers, 10);\n  }\n  \n  countElement.textContent = currentViewers;\n\n  setInterval(function() {\n    const change = getRandomInt(-1, 1);\n    currentViewers += change;\n    if (currentViewers < MIN_VIEWERS) currentViewers = MIN_VIEWERS;\n    if (currentViewers > MAX_VIEWERS) currentViewers = MAX_VIEWERS;\n    sessionStorage.setItem(pageKey, currentViewers);\n    countElement.textContent = currentViewers;\n  }, getRandomInt(3500, 7000));\n})();\n</script>"
